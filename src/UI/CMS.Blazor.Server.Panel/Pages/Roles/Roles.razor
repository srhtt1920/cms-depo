@page "/roles"
@attribute [Authorize]
@layout DashBoardLayout

<PageTitle>Roller — CMS</PageTitle>

@if (!AppState.Session.Can("roles.manage"))
{
    <AccessDenied />
    return;
}

<div class="dash-content-toolbar">
    <div class="left-panel d-flex align-items-center gap-3">
        <span class="cms-page-title">Roller</span>
        <div class="dash-header-sep"></div>
        <a href="/permissions/matrix" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-1">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                <path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2zm2-1a1 1 0 0 0-1 1v4h4V1H2zm5 0v4h4V1H7zm5 0v4h4V2a1 1 0 0 0-1-1h-3zm4 5H9v4h6V6zm0 5H9v4h3a1 1 0 0 0 1-1v-3zm-7 4V11H1v3a1 1 0 0 0 1 1h3zm-4-5h5V6H1v4z" />
            </svg>
            İzin Matrisi
        </a>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenCreate">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
            </svg>
            Yeni Rol
        </button>
        <div class="dash-header-sep"></div>
    </div>
    <div class="right-panel">
        <div class="input-group input-group-sm" style="width:200px">
            <span class="input-group-text bg-transparent"><svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z" /></svg></span>
            <input type="text" class="form-control" placeholder="Ara..." />
        </div>
        <IconButton Icon="icon-refresh" OnClick="LoadAsync" />
    </div>
</div>

<div class="dash-content">
    <div class="dash-content-inner">
        @if (_error is not null)
        {
            <div class="alert alert-danger py-2 small mb-3">@_error</div>
        }


        <!-- İstatistik kartlar -->
        <div class="row g-2 mb-3">
            <div class="col-auto">
                <div class="px-3 py-2 rounded d-flex align-items-center gap-2"
                     style="background:var(--surface-2);border:1px solid var(--border);font-size:13px">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
                        <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z" />
                        <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" />
                    </svg>
                    <strong>@_roles.Sum(r => r.UserCount)</strong> toplam atama
                </div>
            </div>
            <div class="col-auto">
                <div class="px-3 py-2 rounded d-flex align-items-center gap-2"
                     style="background:var(--surface-2);border:1px solid var(--border);font-size:13px">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5V8a.5.5 0 0 1 1 0v2.5a4.5 4.5 0 0 1-4.5 4.5h-5A4.5 4.5 0 0 1 1 10.5v-5A4.5 4.5 0 0 1 5.5 1H8a.5.5 0 0 1 0 1H5.5z" />
                        <path d="M16 3a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                    </svg>
                    <strong>@_roles.Count</strong> rol
                </div>
            </div>
        </div>

        <DataTable Loading="_loading" Error="@_loadError" OnRetry="LoadAsync"
                   CurrentPage="0" TotalCount="_roles.Count" PageSize="_roles.Count">
            <thead>
                <tr>
                    <th><div class="th-inner">Rol Adı</div></th>
                    <th><div class="th-inner">İzinler</div></th>
                    <th><div class="th-inner">Kullanıcı</div></th>
                    <th style="width:100px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _roles)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div style="width:8px;height:8px;border-radius:50%;background:@RoleColor(r.Name);flex-shrink:0"></div>
                                <a href="/roles/@r.Id" class="fw-medium" style="color:var(--text-1);text-decoration:none">@r.Name</a>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var p in r.PermissionKeys.Take(5))
                                {
                                    <span class="badge" style="background:var(--surface-2);border:1px solid var(--border);color:var(--text-2);font-size:10px;font-family:monospace">@p</span>
                                }
                                @if (r.PermissionKeys.Count > 5)
                                {
                                    <span class="badge bg-secondary" style="font-size:10px">+@(r.PermissionKeys.Count - 5)</span>
                                }
                                @if (!r.PermissionKeys.Any())
                                {
                                    <span style="color:var(--text-4);font-size:12px">İzin yok</span>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-light text-dark border">@r.UserCount kullanıcı</span>
                                @if (r.UserCount > 0)
                                {
                                    <a href="/roles/@r.Id" class="btn btn-ghost btn-sm" style="font-size:11px">Görüntüle</a>
                                }
                            </div>
                        </td>
                        <td>
                            <div class="d-flex gap-1 justify-content-end">
                                <a href="/roles/@r.Id" class="btn-ghost btn-icon" title="Detay">
                                    <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                        <path d="M0 8s3-5.5 8-5.5S16 8 16 8s-3 5.5-8 5.5S0 8 0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                    </svg>
                                </a>
                                <button class="btn-ghost btn-icon" title="Düzenle" @onclick="() => OpenEdit(r)">
                                    <SvgIcon Name="icon-pencil" Size="13" />
                                </button>
                                <button class="btn-ghost btn-icon text-danger" title="Sil"
                                        @onclick="() => ConfirmDelete(r)"
                                        disabled="@(r.UserCount > 0)">
                                    <SvgIcon Name="icon-trash" Size="13" />
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!_roles.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4 small">Rol bulunamadı</td></tr>
                }
            </tbody>
        </DataTable>
    </div>
</div>



<!-- Oluştur / Düzenle Modalı -->
@if (_showModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.4)" @onclick="CloseModal">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-semibold">@(_editId.HasValue ? "Rol Düzenle" : "Yeni Rol Oluştur")</h6>
                    <button class="btn-ghost btn-icon" @onclick="CloseModal">
                        <SvgIcon Name="icon-x" Size="14" />
                    </button>
                </div>
                <div class="modal-body">
                    @if (_modalError is not null)
                    {
                        <div class="alert alert-danger py-2 small">@_modalError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Rol Adı *</label>
                        <input @bind="_roleName" type="text" class="form-control form-control-sm"
                               placeholder="örn: Editör, Yönetici" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label small fw-medium">
                            İzinler
                            <span class="text-muted fw-normal">(@_selectedPerms.Count seçili)</span>
                        </label>
                        <div class="d-flex gap-2 mb-2">
                            <button class="btn btn-sm btn-outline-secondary" style="font-size:11px"
                                    @onclick="() => _selectedPerms = new HashSet<string>(_allPermissions)">
                                Tümünü Seç
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" style="font-size:11px"
                                    @onclick="() => _selectedPerms.Clear()">
                                Temizle
                            </button>
                        </div>
                        <div class="row g-1 mt-1">
                            @foreach (var grp in _allPermissions.GroupBy(p => p.Split('.')[0]))
                            {
                                <div class="col-12 col-md-6">
                                    <div class="p-2 rounded" style="background:var(--surface-2);border:1px solid var(--border)">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@grp.All(p => _selectedPerms.Contains(p))"
                                                   @onchange="e => { var on = (bool)e.Value!; foreach (var p in grp) if (on) _selectedPerms.Add(p); else _selectedPerms.Remove(p); }" />
                                            <span class="fw-semibold" style="font-size:11px;text-transform:uppercase;letter-spacing:.04em">@grp.Key</span>
                                        </div>
                                        @foreach (var perm in grp)
                                        {
                                            <div class="form-check form-check-sm ms-3">
                                                <input class="form-check-input" type="checkbox"
                                                       id="mp_@perm"
                                                       checked="@_selectedPerms.Contains(perm)"
                                                       @onchange="e => TogglePerm(perm, (bool)e.Value!)" />
                                                <label class="form-check-label small mono" for="mp_@perm"
                                                       style="font-size:11px">@perm</label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseModal">İptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveRole" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Silme onay modalı -->
@if (_deleteTarget is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.4)" @onclick="() => _deleteTarget = null">
        <div class="modal-dialog modal-sm" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body py-4 text-center">
                    <div class="mb-3">
                        <svg width="36" height="36" fill="var(--red)" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                    </div>
                    <div class="fw-semibold mb-1">Rolü sil?</div>
                    <div class="text-muted small mb-3"><strong>@_deleteTarget.Name</strong> rolü kalıcı silinecek.</div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _deleteTarget = null">İptal</button>
                        <button class="btn btn-danger btn-sm" @onclick="DoDelete" disabled="@_deleting">
                            @if (_deleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<RoleListDto> _roles = [];
    bool _loading, _saving, _deleting, _showModal;
    string? _error, _loadError, _roleName, _modalError;
    Guid? _editId;
    HashSet<string> _selectedPerms = [];
    RoleListDto? _deleteTarget;

    List<string> _allPermissions = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;

        StateHasChanged();

        var rolesR = await RoleApiClient.GetRolesAsync();
        var permsR = await AuthApiClient.GetPermissionsAsync();

        if (rolesR.IsSuccess && rolesR.Data is not null)
            _roles = rolesR.Data;
        else
            _loadError = rolesR.Error?.Message;

        if (permsR.IsSuccess && permsR.Data is not null)
            _allPermissions = FlatAll(permsR.Data.Tree).ToList();

        _loading = false;
    }

    void OpenCreate()
    {
        _editId = null; _roleName = null;
        _selectedPerms = []; _modalError = null; _showModal = true;
    }

    void OpenEdit(RoleListDto r)
    {
        _editId = r.Id; _roleName = r.Name;
        _selectedPerms = [.. r.PermissionKeys];
        _modalError = null; _showModal = true;
    }

    void CloseModal() => _showModal = false;

    void TogglePerm(string p, bool v)
    {
        if (v) _selectedPerms.Add(p); else _selectedPerms.Remove(p);
    }

    async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(_roleName)) { _modalError = "Rol adı zorunlu."; return; }
        _saving = true; _modalError = null;
        bool ok;
        if (_editId.HasValue)
            ok = (await RoleApiClient.UpdateRoleAsync(_editId.Value,
                new UpdateRoleApiRequest(_roleName, [.. _selectedPerms]))).IsSuccess;
        else
            ok = (await RoleApiClient.CreateRoleAsync(
                new CreateRoleApiRequest(_roleName, [.. _selectedPerms]))).IsSuccess;

        _saving = false;
        if (ok)
        {
            CloseModal();
            Toast.Success(_editId.HasValue ? "Rol güncellendi." : "Rol oluşturuldu.");
            await LoadAsync();
        }
        else Toast.Error("İşlem başarısız.");
    }

    void ConfirmDelete(RoleListDto r) => _deleteTarget = r;

    async Task DoDelete()
    {
        if (_deleteTarget is null) return;
        _deleting = true;
        var r = await RoleApiClient.DeleteRoleAsync(_deleteTarget.Id);
        if (r.IsSuccess)
        {
            Toast.Success($"'{_deleteTarget.Name}' rolü silindi.");
            _deleteTarget = null;
            await LoadAsync();
        }
        else _error = r.Error?.Message;
        _deleting = false;
    }

    IEnumerable<string> FlatAll(List<PermissionNodeDto> nodes)
    {
        foreach (var n in nodes)
        {
            yield return n.Key;
            foreach (var c in FlatAll(n.Children)) yield return c;
        }
    }

    static string RoleColor(string name) => name.ToLower() switch
    {
        var n when n.Contains("admin") => "#dc3545",
        var n when n.Contains("editor") => "#0d6efd",
        var n when n.Contains("viewer") => "#198754",
        _ => "#6c757d"
    };
}
