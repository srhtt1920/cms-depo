@page "/two-factor"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>İki Faktörlü Doğrulama — CMS</PageTitle>

<div class="text-center mb-4">
    <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3
                bg-primary bg-opacity-10" style="width:56px;height:56px">
        <svg width="24" height="24" fill="var(--bs-primary)" viewBox="0 0 16 16">
            <path d="M11 1a2 2 0 0 0-2 2v4a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1V3a3 3 0 0 1 6 0v4a1 1 0 0 1-2 0V3a1 1 0 0 0-1-1" />
        </svg>
    </div>
    <h6 class="fw-semibold mb-1">İki Faktörlü Doğrulama</h6>
    <small class="text-muted">Kimlik doğrulayıcı uygulamanızdaki 6 haneli kodu girin</small>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger py-2 small mb-3">@_error</div>
}

@if (_resendSent)
{
    <div class="alert alert-success py-2 small mb-3">Kod tekrar gönderildi.</div>
}

<div class="mb-3">
    <label class="form-label fw-medium small">Doğrulama Kodu</label>
    <input @bind="_code" @bind:event="oninput"
           class="form-control form-control-sm text-center fw-semibold"
           maxlength="6" placeholder="000000"
           style="letter-spacing:.5rem;font-size:1.2rem"
           disabled="@_busy" />
</div>

<button class="btn btn-primary btn-sm w-100 mb-3"
        @onclick="Verify" disabled="@(_busy || _code.Length < 6)">
    @if (_busy)
    {
        <span class="spinner-border spinner-border-sm me-2"></span>
    }
    Doğrula
</button>

<div class="text-center">
    <small class="text-muted">
        Kodu almadınız mı?
        <button class="btn btn-link btn-sm p-0" @onclick="ResendCode" disabled="@_resendBusy">
            @if (_resendBusy)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {

                <span>Yeniden gönder</span>
            }
        </button>
    </small>
</div>

<div class="mt-3 text-center">
    <a href="/login" class="text-muted small">← Giriş sayfasına dön</a>
</div>

@code {
    // Login sayfası 2FA gereken e-postayı session'a yazar:
    // AppState.Session.PendingTwoFactorEmail = email;
    // Nav.NavigateTo("/two-factor");
    private string _code = string.Empty;
    private bool _busy = false;
    private bool _resendBusy = false;
    private bool _resendSent = false;
    private string _error = string.Empty;

    private string? PendingEmail => AppState.Session.PendingTwoFactorEmail;

    private async Task Verify()
    {
        if (_code.Length != 6) return;
        _busy = true;
        _error = string.Empty;
        try
        {
            if (string.IsNullOrWhiteSpace(PendingEmail))
            {
                _error = "Oturum bilgisi bulunamadı. Lütfen tekrar giriş yapın.";
                return;
            }

            var (ok, error, needsSelect) = await Auth.TwoFactorCompleteAsync(_code, PendingEmail);

            if (!ok)
            {
                _error = error ?? "Geçersiz veya süresi dolmuş kod.";
                return;
            }

            Nav.NavigateTo(needsSelect ? "/select-tenant" : "/", forceLoad: false);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ResendCode()
    {
        if (string.IsNullOrWhiteSpace(PendingEmail)) return;
        _resendBusy = true;
        _resendSent = false;
        try
        {
            await AuthApiClient.TwoFactorResendAsync(new TwoFactorResendRequest(PendingEmail));
            _resendSent = true;
        }
        finally
        {
            _resendBusy = false;
        }
    }
}
