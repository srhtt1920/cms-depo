@page "/reset-password"
@layout LoginLayout


<PageTitle>Şifre Sıfırlama</PageTitle>

<div class="auth-card">
    <div class="auth-header">
        <h1>Yeni Şifre Belirle</h1>
        <p>Hesabınız için güvenli bir şifre oluşturun.</p>
    </div>

    @if (_success)
    {
        <div class="alert alert-success">
            <span>✅ Şifreniz başarıyla güncellendi.</span>
        </div>
        <button class="btn btn-primary w-100 mt-3" @onclick='() => Nav.NavigateTo("/login")'>
            Giriş Yap
        </button>
    }
    else if (_tokenInvalid)
    {
        <div class="alert alert-danger">
            <span>❌ Bu bağlantı geçersiz veya süresi dolmuş.</span>
        </div>
        <button class="btn btn-outline-primary w-100 mt-3"
                @onclick='() => Nav.NavigateTo("/forgot-password")'>
            Yeni Bağlantı İste
        </button>
    }
    else
    {
        <EditForm Model="_model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="form-group">
                <label>Yeni Şifre</label>
                <InputText type="password" class="form-control"
                           @bind-Value="_model.NewPassword"
                           placeholder="En az 8 karakter" />
                <ValidationMessage For="() => _model.NewPassword" />
            </div>

            <div class="form-group mt-2">
                <label>Şifre Tekrar</label>
                <InputText type="password" class="form-control"
                           @bind-Value="_model.ConfirmPassword"
                           placeholder="Şifrenizi tekrar girin" />
                <ValidationMessage For="() => _model.ConfirmPassword" />
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-4" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm me-2" />
                }
                Şifremi Güncelle
            </button>
        </EditForm>
    }
</div>

@code {
    [SupplyParameterFromQuery] private string? Token { get; set; }
    [SupplyParameterFromQuery] private string? Email { get; set; }

    private readonly ResetModel _model = new();
    private bool   _loading      = false;
    private bool   _success      = false;
    private bool   _tokenInvalid = false;
    private string? _error;

    protected override void OnInitialized()
    {
        // Token veya email parametresi yoksa geçersiz say
        if (string.IsNullOrWhiteSpace(Token) || string.IsNullOrWhiteSpace(Email))
            _tokenInvalid = true;
    }

    private async Task Submit()
    {
        _loading = true;
        _error   = null;
        try
        {
            var result = await AuthApiClient.ResetPasswordAsync(new ResetPasswordRequest(
                Token!, Email!, _model.NewPassword));

            if (!result.IsSuccess)
            {
                if (result.Error?.Code?.Contains("Token") == true)
                    _tokenInvalid = true;
                else
                    _error = result.Error?.Message ?? "Şifre güncellenemedi.";
                return;
            }
            _success = true;
        }
        finally { _loading = false; }
    }

    private sealed class ResetModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Şifre zorunludur.")]
        [System.ComponentModel.DataAnnotations.MinLength(8, ErrorMessage = "En az 8 karakter olmalıdır.")]
        public string NewPassword { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Şifreler eşleşmiyor.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
