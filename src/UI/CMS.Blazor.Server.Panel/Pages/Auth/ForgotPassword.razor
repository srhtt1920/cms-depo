@page "/forgot-password"
@layout LoginLayout
@attribute [AllowAnonymous]

<PageTitle>Şifremi Unuttum — CMS</PageTitle>

<div class="text-center mb-4">
    <h6 class="fw-semibold mb-1">Şifre Sıfırlama</h6>
    <small class="text-muted">E-posta adresinize sıfırlama bağlantısı göndereceğiz</small>
</div>

@if (_sent)
{
    <div class="alert alert-success py-3 text-center">
        <svg width="20" height="20" fill="currentColor" viewBox="0 0 16 16" class="me-2">
            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
        </svg>
        E-posta gönderildi! Gelen kutunuzu kontrol edin.
    </div>
    <div class="text-center mt-3">
        <a href="/login" class="btn btn-outline-secondary btn-sm">Giriş sayfasına dön</a>
    </div>
}
else
{
    <div class="mb-3">
        <label class="form-label fw-medium small">E-posta</label>
        <input @bind="_email" type="email" class="form-control form-control-sm"
               placeholder="admin@@ornek.com" disabled="@_busy" />
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2 small mb-3">@_error</div>
    }

    <button class="btn btn-primary btn-sm w-100 mb-3"
            @onclick="Send" disabled="@_busy">
        @if (_busy)
        {
            <span class="spinner-border spinner-border-sm me-2"></span>
        }
        Sıfırlama Bağlantısı Gönder
    </button>

    <div class="text-center">
        <a href="/login" class="text-muted small">← Giriş sayfasına dön</a>
    </div>
}

@code {

    private string _email = string.Empty;
    private bool _busy;
    private bool _sent;
    private string _error = string.Empty;
    private bool _loading;

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_email)) return;
        _loading = true;
        _error = string.Empty;
        try
        {
            var result = await AuthApiClient.ForgotPasswordAsync(new ForgotPasswordRequest(_email));
            if (!result.IsSuccess)
            {
                _error = result.Error?.Message ?? "Bir hata oluştu.";
                return;
            }
            _sent = true;
        }
        finally { _loading = false; }
    }
}
