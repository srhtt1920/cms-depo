@page "/tenants"
@attribute [Authorize]
@layout DashBoardLayout
@inject TenantLanguageState LangState

<PageTitle>Tenantlar — CMS</PageTitle>
@if (!AppState.Session.Can("tenants.manage"))
{
    <AccessDenied />
    return;
}


<div class="dash-content-toolbar">
    <div class="left-panel d-flex align-items-center gap-3">
        <span class="cms-page-title">Tenantlar</span>
        <div class="dash-header-sep"></div>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenCreate">
            <svg width="11" height="11" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
            </svg>
            Yeni Tenant
        </button>
    </div>
    <div class="right-panel">
    </div>
    <div class="d-flex align-items-center gap-2">
        <SearchBox @bind-Value="_search" />
        <IconButton Icon="icon-refresh" OnClick="LoadAsync" />
    </div>
</div>

<div class="dash-content">
    <div class="dash-content-inner">
       
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2 small mb-3">@_error</div>
        }

        <DataTable Loading="_loading" Error="@_loadError" OnRetry="LoadAsync"
                   CurrentPage="0" TotalCount="Filtered.Count" PageSize="Filtered.Count">
            <thead>
                <tr>
                    <th><div class="th-inner">Ad</div></th>
                    <th><div class="th-inner">Desteklenen Diller</div></th>
                    <th><div class="th-inner">Varsayılan</div></th>
                    <th><div class="th-inner">Durum</div></th>
                    <th style="width:120px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Filtered)
                {
                    var isActive = AppState.Session.CurrentTenantId == t.Id;
                    <tr class="@(isActive ? "selected" : "")">
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="d-flex align-items-center justify-content-center text-white fw-bold flex-shrink-0"
                                     style="width:30px;height:30px;border-radius:6px;background:@TenantColor(t.Name);font-size:13px">
                                    @char.ToUpper(t.Name[0])
                                </div>
                                <div>
                                    <div class="fw-medium" style="font-size:13px">@t.Name</div>
                                    @if (isActive)
                                    {
                                        <small class="text-success" style="font-size:10px">● Aktif oturum</small>
                                    }
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                @foreach (var l in t.Languages)
                                {
                                    <span class="badge @(l == t.DefaultLanguage ? "bg-primary" : "bg-light text-dark border")"
                                          style="font-size:10px;font-family:monospace">
                                        @l.ToUpper()
                                        @if (l == t.DefaultLanguage)
                                        {
                                            <span style="font-size:8px"> ★</span>
                                        }
                                    </span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-primary" style="font-size:10px;font-family:monospace">
                                @t.DefaultLanguage.ToUpper()
                            </span>
                        </td>
                        <td>
                            <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                @(t.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex gap-1 justify-content-end">
                                <a href="/tenants/@t.Id" class="btn-ghost btn-icon" title="Detay">
                                    <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" /><path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533L8.93 6.588zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0z" /></svg>
                                </a>
                                <button class="btn-ghost btn-icon" title="Dilleri Düzenle"
                                        @onclick="() => OpenEditLangs(t)">
                                    <SvgIcon Name="icon-translate" Size="15" />
                                </button>
                                <button class="btn-ghost btn-icon" title="Adı Düzenle"
                                        @onclick="() => OpenEditName(t)">
                                    <SvgIcon Name="icon-edit" Size="13" />
                                </button>
                                @if (t.IsActive)
                                {
                                    <button class="btn-ghost btn-icon text-danger" title="Deaktive Et"
                                            @onclick="() => ConfirmDeactivate(t)">
                                        <SvgIcon Name="icon-x" Size="13" />
                                    </button>
                                }
                                else
                                {
                                    <button class="btn-ghost btn-icon text-success" title="Aktive Et"
                                            @onclick="() => Activate(t.Id)">
                                        <svg width="13" height="13" fill="currentColor" viewBox="0 0 16 16">
                                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Filtered.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4 small">Tenant bulunamadı</td></tr>
                }
            </tbody>
        </DataTable>
    </div>
</div>




<!-- ── Modal: Yeni Tenant / Ad Düzenle ────────────────────────── -->
@if (_showNameModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.45)" @onclick="CloseModal">
        <div class="modal-dialog modal-md" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-semibold">
                        @(_editId.HasValue ? "Tenant Adı Düzenle" : "Yeni Tenant Oluştur")
                    </h6>
                    <button class="btn-ghost btn-icon" @onclick="CloseModal">
                        <SvgIcon Name="icon-x" Size="14" />
                    </button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger py-2 small">@_modalError</div>
                    }
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Tenant Adı <span class="text-danger">*</span></label>
                        <input @bind="_tenantName" type="text" class="form-control form-control-sm"
                               placeholder="Şirket / proje adı" />
                    </div>
                    @if (!_editId.HasValue)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-medium">
                                Başlangıç Dilleri
                                <span class="text-muted fw-normal">(virgülle ayırın)</span>
                            </label>
                            <input @bind="_langInput" type="text" class="form-control form-control-sm"
                                   placeholder="tr, en, de" />
                            <div class="form-text">İlk dil varsayılan kabul edilir.</div>
                        </div>
                        <div class="row g-1 mt-1">
                            @foreach (var l in _quickLangs)
                            {
                                var selected = LangInputList().Contains(l.Code);
                                <div class="col-auto">
                                    <button class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-secondary")"
                                            style="font-size:11px;min-width:44px"
                                            @onclick="() => ToggleQuickLang(l.Code)">
                                        @l.Code.ToUpper()
                                        <span style="font-size:9px;opacity:.7">@l.Name</span>
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseModal">İptal</button>
                    <button class="btn btn-primary btn-sm" @onclick="SaveTenant" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Modal: Dil Yönetimi ─────────────────────────────────────── -->
@if (_showLangModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.45)" @onclick="CloseModal">
        <div class="modal-dialog modal-lg" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <h6 class="modal-title fw-semibold">Dil Yönetimi — @_editName</h6>
                    <button class="btn-ghost btn-icon" @onclick="CloseModal"><SvgIcon Name="icon-x" Size="14" /></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(_modalError))
                    {
                        <div class="alert alert-danger py-2 small">@_modalError</div>
                    }

                    <!-- Kaldırılacak dil uyarısı -->
                    @if (_removedLangs.Any())
                    {
                        <div class="alert py-2 px-3 mb-3 d-flex align-items-start gap-2"
                             style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.3)">
                            <svg width="14" height="14" fill="#dc2626" viewBox="0 0 16 16" class="mt-1 flex-shrink-0">
                                <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                            </svg>
                            <div>
                                <div class="fw-semibold small" style="color:#991b1b">Kaldırılacak diller</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var l in _removedLangs)
                                    {
                                        <span class="badge bg-danger" style="font-size:10px">@l.ToUpper()</span>
                                    }
                                </div>
                                <div class="small mt-1" style="color:#7f1d1d">
                                    Bu dillerdeki içerik çevirileri <strong>eksik</strong> olarak işaretlenecek.
                                    İçerik silinmeyecek ancak yayınlama skorları düşebilir.
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Eklenen dil bilgisi -->
                    @if (_addedLangs.Any())
                    {
                        <div class="alert py-2 px-3 mb-3 d-flex align-items-start gap-2"
                             style="background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.3)">
                            <svg width="14" height="14" fill="#059669" viewBox="0 0 16 16" class="mt-1 flex-shrink-0">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                            </svg>
                            <div>
                                <div class="fw-semibold small" style="color:#065f46">Eklenecek diller</div>
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (var l in _addedLangs)
                                    {
                                        <span class="badge bg-success" style="font-size:10px">@l.ToUpper()</span>
                                    }
                                </div>
                                <div class="small mt-1" style="color:#064e3b">
                                    Mevcut içerikler bu dilde <strong>eksik çeviri</strong> uyarısı alacak.
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Dil seçici -->
                    <div class="mb-3">
                        <label class="form-label small fw-medium">Desteklenen Diller</label>
                        <div class="row g-2">
                            @foreach (var l in _quickLangs)
                            {
                                var active = EditLangList().Contains(l.Code);
                                var isDefault = _defaultLang?.Equals(l.Code, StringComparison.OrdinalIgnoreCase) == true;
                                var wasOriginal = _originalLangs.Contains(l.Code);
                                var removed = wasOriginal && !active;
                                var added = !wasOriginal && active;

                                <div class="col-6 col-md-4">
                                    <div class="d-flex align-items-center gap-2 p-2 rounded"
                                         style="border:2px solid @(active ? (removed ? "var(--red)" : "var(--accent)") : "var(--border)");
                                                                        background:@(active ? (added ? "rgba(16,185,129,.06)" : "rgba(99,102,241,.06)") : "var(--surface-2)");
                                                                        cursor:pointer"
                                         @onclick="() => ToggleEditLang(l.Code)">
                                        <input type="checkbox" class="form-check-input" checked="@active"
                                               @onclick:stopPropagation @onchange="() => ToggleEditLang(l.Code)" />
                                        <div style="flex:1">
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="fw-medium" style="font-size:12px">@l.Code.ToUpper()</span>
                                                <span class="text-muted" style="font-size:10px">@l.Name</span>
                                                @if (added)
                                                {
                                                    <span class="badge bg-success ms-1" style="font-size:9px">+Yeni</span>
                                                }
                                                @if (removed)
                                                {
                                                    <span class="badge bg-danger ms-1" style="font-size:9px">Kaldır</span>
                                                }
                                            </div>
                                        </div>
                                        @if (active)
                                        {
                                            <button class="btn btn-ghost btn-sm"
                                                    style="font-size:9px;padding:1px 5px;color:@(isDefault ? "var(--accent)" : "var(--text-3)")"
                                                    title="Varsayılan yap" @onclick:stopPropagation
                                                    @onclick="() => _defaultLang = l.Code">
                                                @(isDefault ? "★ Varsayılan" : "Varsayılan yap")
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label small fw-medium">Özel dil ekle</label>
                        <div class="input-group input-group-sm" style="max-width:280px">
                            <input @bind="_customLangInput" type="text"
                                   class="form-control" placeholder="zh, ja, ko, ar..." maxlength="5" />
                            <button class="btn btn-outline-secondary" @onclick="AddCustomLang">Ekle</button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="CloseModal">İptal</button>
                    <button class="btn @(_removedLangs.Any() ? "btn-danger" : "btn-primary") btn-sm"
                            @onclick="SaveLanguages" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        @(_removedLangs.Any() ? $"{_removedLangs.Count} dil kaldırılacak — Kaydet" : "Güncelle")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- ── Deaktive onay modalı ───────────────────────────────────── -->
@if (_deactivateTarget is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.45)" @onclick="() => _deactivateTarget = null">
        <div class="modal-dialog modal-sm" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body py-4 text-center">
                    <svg width="36" height="36" fill="var(--red)" viewBox="0 0 16 16" class="mb-3">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                    </svg>
                    <div class="fw-semibold mb-1">Tenant deaktive edilsin mi?</div>
                    <div class="text-muted small mb-3">
                        <strong>@_deactivateTarget.Name</strong> — kullanıcılar bu tenant'a erişemez.
                    </div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _deactivateTarget = null">İptal</button>
                        <button class="btn btn-danger btn-sm" @onclick="DoDeactivate" disabled="@_saving">
                            @if (_saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Deaktive Et
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    record QuickLang(string Code, string Name);
    readonly QuickLang[] _quickLangs =
    [
        new("tr", "Türkçe"), new("en", "English"), new("de", "Deutsch"),
        new("es", "Español"), new("fr", "Français"), new("ar", "العربية"),
        new("ru", "Русский"), new("zh", "中文"),    new("ja", "日本語"),
        new("ko", "한국어"),   new("nl", "Nederlands"), new("pl", "Polski"),
    ];

    List<TenantListDto> _tenants = [];
    TenantListDto? _deactivateTarget;
    bool _loading, _saving;
    bool _showNameModal, _showLangModal;
    string _error = "", _loadError = "", _modalError = "";
    string _search = "";
    string? _tenantName, _langInput, _defaultLang, _editName, _customLangInput;
    Guid? _editId;

    List<TenantListDto> Filtered => _tenants
    .Where(u => string.IsNullOrEmpty(_search) || u.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
    .ToList();

    // Lang modal state
    HashSet<string> _editLangs = [];
    HashSet<string> _originalLangs = [];
    IReadOnlyList<string> _removedLangs => _originalLangs.Where(l => !_editLangs.Contains(l)).ToList();
    IReadOnlyList<string> _addedLangs => _editLangs.Where(l => !_originalLangs.Contains(l)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true; _loadError = "";
        var r = await TenantApiClient.GetTenantsAsync();
        if (r.IsSuccess && r.Data is not null) _tenants = r.Data;
        else _loadError = r.Error?.Message ?? "Tenantlar yüklenemedi.";
        _loading = false;
    }

    // ── Create / edit name ────────────────────────────────────────

    void OpenCreate()
    {
        _editId = null; _tenantName = ""; _langInput = "tr, en"; _modalError = "";
        _showNameModal = true;
    }

    void OpenEditName(TenantListDto t)
    {
        _editId = t.Id; _tenantName = t.Name; _modalError = "";
        _showNameModal = true;
    }

    async Task SaveTenant()
    {
        if (string.IsNullOrWhiteSpace(_tenantName)) { _modalError = "Ad zorunlu."; return; }
        _saving = true; _modalError = "";

        if (_editId.HasValue)
        {
            var r = await TenantApiClient.UpdateTenantAsync(_editId.Value, new UpdateTenantNameRequest(_tenantName));
            if (r.IsSuccess) { CloseModal(); await LoadAsync(); await LangState.EnsureLoadedAsync(true); }
            else Toast.Error(r.Error?.Message ?? "Güncelleme başarısız."); CloseModal();
        }
        else
        {
            var langs = LangInputList();
            if (!langs.Any()) { _modalError = "En az bir dil ekleyin."; _saving = false; return; }
            var r = await TenantApiClient.CreateTenantAsync(new CreateTenantRequest(_tenantName, langs));
            if (r.IsSuccess) { CloseModal(); await LoadAsync(); }
            else Toast.Error(r.Error?.Message ?? "Oluşturma başarısız."); CloseModal();
        }
        _saving = false;
    }

    // ── Language management ───────────────────────────────────────

    void OpenEditLangs(TenantListDto t)
    {
        _editId = t.Id; _editName = t.Name;
        _editLangs = new HashSet<string>(t.Languages, StringComparer.OrdinalIgnoreCase);
        _originalLangs = new HashSet<string>(t.Languages, StringComparer.OrdinalIgnoreCase);
        _defaultLang = t.DefaultLanguage;
        _customLangInput = "";
        _modalError = "";
        _showLangModal = true;
    }

    void ToggleEditLang(string code)
    {
        if (_editLangs.Contains(code))
        {
            if (_editLangs.Count <= 1) return; // en az bir dil
            _editLangs.Remove(code);
            if (_defaultLang == code) _defaultLang = _editLangs.First();
        }
        else _editLangs.Add(code);
    }

    void AddCustomLang()
    {
        var code = (_customLangInput ?? "").Trim().ToLower();
        if (code.Length is >= 2 and <= 5)
        {
            _editLangs.Add(code);
            _customLangInput = "";
        }
    }

    async Task SaveLanguages()
    {
        if (!_editId.HasValue) return;
        if (!_editLangs.Any()) { _modalError = "En az bir dil gerekli."; return; }
        _saving = true; _modalError = "";

        var r = await TenantApiClient.UpdateTenantLanguagesAsync(_editId.Value,
            new UpdateLanguagesApiRequest([.. _editLangs], _defaultLang ?? _editLangs.First()));

        if (r.IsSuccess)
        {
            CloseModal();
            await LoadAsync();
            // Tenant dil state'ini zorla güncelle — MissingTranslationAlert re-render alacak
            await LangState.EnsureLoadedAsync(forceRefresh: true);
        }
        else Toast.Error(r.Error?.Message ?? "Güncelleme başarısız."); CloseModal();
        _saving = false;
    }

    // ── Deactivate / activate ─────────────────────────────────────

    void ConfirmDeactivate(TenantListDto t) => _deactivateTarget = t;

    async Task DoDeactivate()
    {
        if (_deactivateTarget is null) return;
        _saving = true;
        var r = await TenantApiClient.DeactivateTenantAsync(_deactivateTarget.Id);
        if (r.IsSuccess) { _deactivateTarget = null; await LoadAsync(); }
        else _error = r.Error?.Message ?? "Deaktivasyon başarısız.";
        _saving = false;
    }

    async Task Activate(Guid id)
    {
        // API'de ayrı bir activate endpoint yoksa UpdateTenantAsync ile name güncelle
        // veya DeactivateTenantAsync'in toggle davrandığını varsay.
        // Şimdilik LoadAsync yeterli — gerçek endpoint eklenince burası güncellenmeli.
        await LoadAsync();
    }

    // ── Helpers ───────────────────────────────────────────────────

    void CloseModal() { _showNameModal = false; _showLangModal = false; }

    List<string> LangInputList() =>
        (_langInput ?? "").Split(',')
            .Select(l => l.Trim().ToLower())
            .Where(l => l.Length >= 2)
            .Distinct()
            .ToList();

    List<string> EditLangList() => _editLangs.ToList();

    void ToggleQuickLang(string code)
    {
        var list = LangInputList();
        if (list.Contains(code)) list.Remove(code); else list.Add(code);
        _langInput = string.Join(", ", list);
    }

    static string TenantColor(string name)
    {
        string[] p = ["#6366f1", "#8b5cf6", "#ec4899", "#f59e0b", "#10b981", "#0ea5e9", "#ef4444"];
        return p[Math.Abs(name.GetHashCode()) % p.Length];
    }
}
