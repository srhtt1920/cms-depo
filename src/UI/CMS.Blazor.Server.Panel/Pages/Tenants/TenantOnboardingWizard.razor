        height: 44px;
        border-radius: 12px;
        background: var(--brand-light,#ede9fe);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .wizard-steps {
        display: flex;
        align-items: center;
    }

