        color: var(--accent);
        font-weight: 600;
    }

    .wizard-step.done .step-label {
        color: #15803d;
    }

    .step-connector {
        flex: 1;
        height: 2px;
        background: var(--border);
        margin: 0 8px;
    }

    .wizard-step.done + .wizard-step .step-connector, .wizard-step.done .step-connector {
        background: #22c55e;
    }

    .wizard-card {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 1rem;
    }

    .wizard-card-header {
        padding: .75rem 1.25rem;
        background: var(--surface-1);
        border-bottom: 1px solid var(--border);
