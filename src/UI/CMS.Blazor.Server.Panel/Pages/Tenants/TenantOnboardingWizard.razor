@page "/tenants/new"
@attribute [Authorize]
@layout DashBoardLayout

<PageTitle>Yeni Tenant Oluştur — CMS</PageTitle>
@if (!Guard.IsSuperAdmin && !AppState.Session.Can("tenants.manage"))
{
    <AccessDenied />
    return;
}

<div class="dash-content-toolbar">
    <div class="left-panel d-flex align-items-center gap-3">
        <span class="cms-page-title">Kullanıcılar</span>
        <div class="dash-header-sep"></div>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenAdd">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            Kullanıcı Ekle
        </button>
    </div>
    <div class="right-panel">
    </div>
    <div class="d-flex align-items-center gap-2">
        <SearchBox @bind-Value="_search" />
        <IconButton Icon="icon-refresh" OnClick="LoadAsync" />
    </div>
</div>

<div class="dash-content">
    <div class="dash-content-inner">
    </div>
</div>

<div class="wizard-shell">

    <div class="d-flex align-items-center gap-3 mb-5">
        <div class="wizard-logo-bubble">🏢</div>
        <div>
            <h1 style="font-size:1.4rem;font-weight:700;margin:0">Yeni Tenant Oluştur</h1>
            <div class="text-muted small">Adım adım kurulum yaparak yeni bir tenant hazırlayın</div>
        </div>
        <a href="/tenants" class="btn btn-ghost btn-sm ms-auto">✕ İptal</a>
    </div>

    <!-- Adım göstergesi -->
    <div class="wizard-steps mb-4">
        @for (int i = 0; i < _steps.Length; i++)
        {
            var idx = i;
            <div class="wizard-step @(_currentStep > idx ? "done" : "") @(_currentStep == idx ? "active" : "")">
                <div class="step-bubble">
                    @if (_currentStep > idx)
                    {
                        <span>✓</span>
                    }
                    else
                    {

                        <span>@(idx + 1)</span>
                    }
                </div>
                <span class="step-label">@_steps[idx]</span>
                @if (idx < _steps.Length - 1)
                {
                    <div class="step-connector"></div>
                }
            </div>
        }
    </div>

    <!-- ── Adım 0: Temel Bilgiler ── -->
    @if (_currentStep == 0)
    {
        <div class="wizard-card">
            <div class="wizard-card-header">🏢 Temel Bilgiler</div>
            <div class="wizard-card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium">Tenant Adı <span class="text-danger">*</span></label>
                        <input @bind="_name" @bind:event="oninput" @bind:after="GenerateSubdomain"
                               type="text" class="form-control form-control-sm"
                               placeholder="Şirket veya proje adı" autofocus />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium">Subdomain <span class="text-danger">*</span></label>
                        <div class="input-group input-group-sm">
                            <input @bind="_subdomain" @bind:event="oninput" @bind:after="CheckSubdomainAsync"
                                   type="text"
                                   class="form-control @(_subdomainValid == true ? "is-valid" : _subdomainValid == false ? "is-invalid" : "")"
                                   placeholder="sirket-adi" />
                            <span class="input-group-text" style="font-size:11px">.cms.app</span>
                        </div>
                        @if (_subdomainValid == true)
                        {
                            <div class="valid-feedback d-block" style="font-size:11px">✓ Subdomain kullanılabilir</div>
                        }
                        else if (_subdomainValid == false)
                        {

                            <div class="invalid-feedback d-block" style="font-size:11px">Bu subdomain kullanımda veya geçersiz</div>
                        }
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium">Varsayılan Dil</label>
                        <select class="form-select form-select-sm" @bind="_defaultLanguage">
                            <option value="tr">Türkçe (tr)</option>
                            <option value="en">İngilizce (en)</option>
                            <option value="de">Almanca (de)</option>
                            <option value="fr">Fransızca (fr)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── Adım 1: Marka ── -->
    @if (_currentStep == 1)
    {
        <div class="wizard-card">
            <div class="wizard-card-header">🎨 Marka & Domain</div>
            <div class="wizard-card-body">
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium">Marka Rengi</label>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <input type="color" @bind="_brandColor"
                                   style="width:40px;height:34px;border:none;padding:2px;border-radius:6px;cursor:pointer" />
                            <input @bind="_brandColor" type="text" class="form-control form-control-sm"
                                   style="font-family:monospace;width:110px" />
                        </div>
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var c in new[] { "#6366f1", "#ec4899", "#22c55e", "#f59e0b", "#3b82f6", "#ef4444" })
                            {
                                var col = c;
                                <button class="color-preset" style="background:@col" @onclick="() => _brandColor = col" title="@col"></button>
                            }
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-medium">Özel Domain (opsiyonel)</label>
                        <input @bind="_customDomain" type="text" class="form-control form-control-sm"
                               placeholder="cms.sirketiniz.com" />
                        <div class="form-text" style="font-size:11px">Özel domain için DNS CNAME kaydı gerekmektedir.</div>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="small fw-semibold text-muted mb-2">CANLÍ ÖNİZLEME</div>
                    <div class="branding-preview">
                        <div class="bp-topbar">
                            <div class="bp-logo">
                                <div class="bp-logo-dot" style="background:@_brandColor">
                                    @(string.IsNullOrEmpty(_name) ? "?" : _name[..1].ToUpper())
                                </div>
                                <span class="bp-tenant-name">@(string.IsNullOrEmpty(_name) ? "Tenant" : _name)</span>
                            </div>
                        </div>
                        <div class="bp-nav">
                            <div class="bp-nav-item" style="border-left-color:@_brandColor;color:@_brandColor;background:@_brandColor+" 15"">📄 İçerikler</div>
                            <div class="bp-nav-item">📁 Sayfalar</div>
                        </div>
                        <button class="bp-btn" style="background:@_brandColor">+ Yeni İçerik</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ── Adım 2: Plan ── -->
    @if (_currentStep == 2)
    {
        <div class="wizard-card">
            <div class="wizard-card-header">📦 Plan Seçimi</div>
            <div class="wizard-card-body">
                <div class="row g-3 mb-4">
                    @foreach (var (key, label, price, features) in _plans)
                    {
                        var k = key;
                        <div class="col-12 col-md-4">
                            <div class="plan-card @(_plan == k ? "selected" : "")" @onclick="() => _plan = k">
                                @if (k == "pro")
                                {
                                    <div class="plan-badge">⭐ POPÜLER</div>
                                }
                                <div class="plan-name">@label</div>
                                <div class="plan-price">@price</div>
                                <ul class="plan-features">
                                    @foreach (var f in features)
                                    {
                                        <li>✓ @f</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- ── Adım 3: Özet & Tamamla ── -->
    @if (_currentStep == 3)
    {
        @if (_provisioning)
        {
            <div class="wizard-card">
                <div class="wizard-card-header">⚙️ Tenant Hazırlanıyor...</div>
                <div class="wizard-card-body p-0">
                    @foreach (var item in _checklist)
                    {
                        <div class="checklist-row @(item.Done ? "done" : "")">
                            <div class="checklist-icon">
                                @if (item.Done)
                                {
                                    <span style="color:#22c55e;font-size:14px">✓</span>
                                }
                                else if (item.Running)
                                {

                                    <div class="spinner-border spinner-border-sm" style="color:var(--accent);width:.8rem;height:.8rem"></div>
                                }
                                else
                                {

                                    <span style="color:var(--border)">○</span>
                                }
                            </div>
                            <div>
                                <div class="checklist-title">@item.Title</div>
                                @if (!string.IsNullOrEmpty(item.Hint))
                                {
                                    <div class="checklist-hint">@item.Hint</div>
                                }
                            </div>
                        </div>
                    }
                </div>
                @if (_provisionError is not null)
                {
                    <div class="p-3">
                        <div class="alert alert-danger py-2 small mb-0">@_provisionError</div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="wizard-card">
                <div class="wizard-card-header">📋 Özet — Her şey doğru görünüyor mu?</div>
                <div class="wizard-card-body">
                    @foreach (var (label, val) in new[]{
                        ("Tenant Adı", _name),
                        ("Subdomain",  _subdomain + ".cms.app"),
                        ("Varsayılan Dil", _defaultLanguage.ToUpper()),
                        ("Özel Domain", string.IsNullOrEmpty(_customDomain) ? "—" : _customDomain),
                        ("Plan", _plans.FirstOrDefault(p=>p.Key==_plan).Label ?? "Pro"),
                        })
                    {
                        <div class="summary-row">
                            <span class="summary-label">@label</span>
                            <span class="summary-value">@val</span>
                        </div>
                    }
                    <div class="summary-row">
                        <span class="summary-label">Marka Rengi</span>
                        <div class="d-flex align-items-center gap-2">
                            <div style="width:14px;height:14px;border-radius:4px;background:@_brandColor;border:1px solid var(--border)"></div>
                            <span class="summary-value" style="font-family:monospace;font-size:11px">@_brandColor</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Footer -->
    @if (!_provisioning || _provisionError is not null)
    {
        <div class="wizard-footer">
            <div>
                @if (_currentStep > 0)
                {
                    <button class="btn btn-ghost btn-sm" @onclick="() => _currentStep--" disabled="@_saving">← Geri</button>
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="text-muted" style="font-size:12px">@(_currentStep + 1) / @_steps.Length</span>
                @if (_currentStep < _steps.Length - 1)
                {
                    <button class="btn btn-primary btn-sm" @onclick="NextStep" disabled="@(!CanAdvance)">İleri →</button>
                }
                else if (_provisionError is null)
                {
                    <button class="btn btn-success btn-sm d-flex align-items-center gap-2"
                            @onclick="FinishAsync" disabled="@_saving">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm" style="width:.75rem;height:.75rem"></span>
                        }
                        🚀 Tenant'ı Oluştur
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-danger btn-sm" @onclick="() => { _provisioning = false; _saving = false; }">
                        ← Formu Düzelt
                    </button>
                }
            </div>
        </div>
    }
</div>

<style>
