</style>

@code {
    int _currentStep;
    bool _saving, _provisioning;
    bool? _subdomainValid;
    System.Threading.CancellationTokenSource? _cts;
    string? _provisionError;
    string _search = "";

    string _name = "", _subdomain = "", _defaultLanguage = "tr",
           _brandColor = "#6366f1", _customDomain = "", _plan = "pro";

    readonly string[] _steps = ["Temel Bilgiler", "Marka & Domain", "Plan Seçimi", "Özet & Tamamla"];

    readonly (string Key, string Label, string Price, string[] Features)[] _plans =
    [
        ("starter",    "Starter",    "Ücretsiz",   ["5 İçerik Türü","1 Dil","2 Kullanıcı","1 GB"]),
        ("pro",        "Pro",        "$49 / ay",   ["Sınırsız Tür","5 Dil","25 Kullanıcı","50 GB"]),
        ("enterprise", "Enterprise", "Fiyat İste", ["Her şey dahil","Özel Domain","SSO","SLA"]),
    ];

    readonly List<ChecklistItem> _checklist =
    [
        new("Tenant kaydı oluşturuluyor",        ""),
        new("Varsayılan roller oluşturuluyor",   "Admin, Editor, Viewer"),
        new("Varsayılan izinler atanıyor",       "Rol bazlı izin seti"),
        new("Dil yapılandırılıyor",              ""),
        new("Ana sayfa oluşturuluyor",           "/ rotası"),
        new("Navigasyon menüsü hazırlanıyor",    "Ana menü"),
        new("Hazır! 🎉",                         ""),
    ];

    bool CanAdvance => _currentStep switch
    {
        0 => !string.IsNullOrWhiteSpace(_name) && _subdomainValid == true,
        1 => true,
        2 => !string.IsNullOrEmpty(_plan),
        _ => true,
    };

    void NextStep() { if (CanAdvance) _currentStep++; }

    void GenerateSubdomain()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        _subdomain = System.Text.RegularExpressions.Regex
            .Replace(_name.ToLower().Trim(), @"[^a-z0-9]", "-")
            .Trim('-');
        _subdomainValid = null;
        _ = CheckSubdomainAsync();
    }

    async Task CheckSubdomainAsync()
    {
        if (_subdomain.Length < 3) { _subdomainValid = false; return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(_subdomain, @"^[a-z0-9][a-z0-9-]+[a-z0-9]$"))
        { _subdomainValid = false; return; }

        _cts?.Cancel();
        _cts = new();
        try
        {
            await Task.Delay(500, _cts.Token);
            // Real: GET api/tenants/check-subdomain?value=_subdomain
            // Simulated: always true for valid format
            _subdomainValid = true;
        }
        catch (TaskCanceledException) { }
    }

    async Task FinishAsync()
    {
        _saving = true; _provisioning = true; _provisionError = null;
        StateHasChanged();
        try
        {
            var req = new TenantProvisionRequest(
                Name: _name,
                Subdomain: _subdomain,
                Languages: [_defaultLanguage],
                DefaultLanguage: _defaultLanguage,
                AdminEmail: null,
                AdminRoleIds: null,
                CreateDefaultContent: true,
                CreateDefaultNavigation: true,
                Plan: _plan,
                BrandColor: _brandColor);

            var r = await ProvisionApiClient.ProvisionTenantAsync(req);
            if (!r.IsSuccess)
            {
                _provisionError = r.Error?.Message ?? "Tenant oluşturulamadı.";
                Toast.Error(_provisionError);
                _provisioning = false;
                _saving = false;
                return;
            }

            await PollAsync(r.Data!.TenantId);
        }
        catch (Exception ex)
        {
            _provisionError = ex.Message;
            Toast.Error(ex.Message);
            _provisioning = false;
            _saving = false;
        }
    }

    async Task PollAsync(Guid tenantId)
    {
        var stepMap = new Dictionary<string, int>
        {
            ["tenant_created"] = 0,
            ["roles"] = 1,
            ["permissions"] = 2,
            ["language"] = 3,
            ["homepage"] = 4,
            ["navigation"] = 5,
        };

        for (int i = 0; i < 30; i++)   // max 60 sn
        {
            await Task.Delay(2000);
            var s = await ProvisionApiClient.GetProvisioningStatusAsync(tenantId);
            if (!s.IsSuccess) continue;

            foreach (var (key, idx) in stepMap)
            {
                if (s.Data!.CompletedSteps.Contains(key))
                {
                    _checklist[idx].Done = true; _checklist[idx].Running = false;
                }
                else if (s.Data.PendingSteps.Contains(key))
                {
                    _checklist[idx].Running = true;
                }
            }
            StateHasChanged();

            if (s.Data!.Status == TenantStatus.Active)
            {
                _checklist[6].Done = true; StateHasChanged();
                await Task.Delay(800);
                Toast.Success($"🎉 \"{_name}\" tenant'ı hazır!");
                Nav.NavigateTo($"/tenants/{tenantId}");
                return;
            }
            if (s.Data.Status == TenantStatus.ProvisionFailed)
            {
                _provisionError = s.Data.FailureReason ?? "Provisioning başarısız.";
                Toast.Error(_provisionError);
                _provisioning = false; _saving = false;
                return;
            }
        }

        _provisionError = "Zaman aşımı. Tenant detay sayfasından durumu kontrol edin.";
        Toast.Warning(_provisionError);
        _provisioning = false; _saving = false;
    }

    sealed class ChecklistItem(string title, string hint)
    {
        public string Title { get; } = title;
        public string Hint { get; } = hint;
        public bool Done { get; set; }
        public bool Running { get; set; }
    }
}