@page "/tenants/{TenantId:guid}"
@attribute [Authorize]
@layout DashBoardLayout

<PageTitle>Tenant Detayı — CMS</PageTitle>
@if (!AppState.Session.Can("superadmin"))
{
    <AccessDenied />
    return;
}

<div class="dash-content-toolbar">
    <div class="left-panel d-flex align-items-center gap-3">
        <span class="cms-page-title">Kullanıcılar</span>
        <div class="dash-header-sep"></div>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenAdd">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            Kullanıcı Ekle
        </button>
    </div>
    <div class="right-panel">
    </div>
    <div class="d-flex align-items-center gap-2">
        <SearchBox @bind-Value="_search" />
        <IconButton Icon="icon-refresh" OnClick="LoadAsync" />
    </div>
</div>

<div class="dash-content">
    <div class="dash-content-inner">
    </div>
</div>

<PageHeader Title="@(_detail?.Name ?? "Tenant")" Subtitle="Tenant ayarları ve yönetim">
    <Actions>
        <a href="/tenants" class="btn btn-ghost btn-sm">← Listéye Dön</a>
        @if (_detail is not null)
        {
            <a href="/tenants/@TenantId/maintenance" class="btn btn-outline-warning btn-sm">🔧 Bakım Modu</a>
        }
    </Actions>
</PageHeader>



@if (_loading)
{
    <div class="text-center p-5">
        <div class="spinner-border" style="width:1.5rem;height:1.5rem;color:var(--accent)"></div>
    </div>
}
else if (_error is not null)
{
    <div class="alert alert-danger py-2 small">
        @_error <button class="btn btn-link btn-sm" @onclick="LoadAsync">Tekrar dene</button>
    </div>
}
else if (_detail is not null)
{
    <div class="row g-3">
        <!-- Sol: İstatistik kartı -->
        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold
                                            text-white" style="width:52px;height:52px;font-size:1.4rem;background:var(--accent)">
                            @_detail.Name[..1].ToUpper()
                        </div>
                        <div>
                            <div class="fw-semibold">@_detail.Name</div>
                            <div class="d-flex gap-1 mt-1">
                                <span class="badge @(_detail.IsActive ? "bg-success" : "bg-danger")">
                                    @(_detail.IsActive ? "Aktif" : "Pasif")
                                </span>
                                @if (_detail.Maintenance?.IsMaintenanceMode == true)
                                {
                                    <span class="badge bg-warning text-dark">🔧 Bakımda</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="row g-2 text-center mb-3">
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:var(--surface-2)">
                                <div class="fw-bold" style="font-size:1.4rem;color:var(--accent)">
                                    @_detail.UserCount
                                </div>
                                <div style="font-size:11px;color:var(--text-3)">Kullanıcı</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-2 rounded" style="background:var(--surface-2)">
                                <div class="fw-bold" style="font-size:1.4rem;color:var(--accent)">
                                    @_detail.ContentCount
                                </div>
                                <div style="font-size:11px;color:var(--text-3)">İçerik</div>
                            </div>
                        </div>
                    </div>

                    <div class="small mb-1">
                        <span class="text-muted">Oluşturulma:</span>
                        <span class="ms-1 fw-medium">@_detail.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="small mb-1">
                        <span class="text-muted">Son Aktivite:</span>
                        <span class="ms-1">@(_detail.LastActivityAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</span>
                    </div>
                    <div class="small">
                        <span class="text-muted">ID:</span>
                        <code style="font-size:9px">@TenantId</code>
                    </div>
                </div>
            </div>

            <!-- Tehlike zonu -->
            <div class="card border-0 shadow-sm" style="border:1px solid #ef4444!important">
                <div class="card-body p-3">
                    <div class="small fw-semibold text-danger mb-3">⚠️ TEHLİKELİ BÖLGE</div>
                    @if (_detail.IsActive)
                    {
                        <button class="btn btn-outline-danger btn-sm w-100"
                                @onclick="() => _confirmDeact = true" disabled="@_busy">
                            Tenant'ı Devre Dışı Bırak
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-danger py-2 small mb-0">
                            Bu tenant pasif. Kullanıcılar erişemiyor.
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Sağ: Sekmeler -->
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent pt-3 pb-0 px-3">
                    <ul class="nav nav-tabs border-0 card-header-tabs">
                        @foreach (var t in new[] { "Genel", "Diller", "Kullanıcılar" })
                        {
                            var tab = t;
                            <li class="nav-item">
                                <button class="nav-link @(_tab == tab ? "active" : "")"
                                        style="font-size:13px" @onclick="() => _tab = tab">
                                    @tab
                                    @if (t == "Kullanıcılar")
                                    {
                                        <span class="badge bg-secondary ms-1" style="font-size:9px">
                                            @_detail.Users.Count
                                        </span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-body p-4">

                    @if (_tab == "Genel")
                    {
                        <div class="mb-4">
                            <label class="form-label small fw-medium">Tenant Adı</label>
                            <div class="d-flex gap-2">
                                <input @bind="_editName" type="text" class="form-control form-control-sm" />
                                <button class="btn btn-primary btn-sm" @onclick="SaveNameAsync" disabled="@_busy">
                                    @if (_busy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Kaydet
                                </button>
                            </div>
                        </div>
                        <hr />
                        <div class="small fw-semibold text-muted mb-2">BAKIM DURUMU</div>
                        @if (_detail.Maintenance?.IsMaintenanceMode == true)
                        {
                            <div class="p-3 rounded mb-2" style="background:#fef3c7;border-left:3px solid #f59e0b">
                                <div class="fw-medium small mb-1">🔧 Bakım Aktif</div>
                                @if (!string.IsNullOrEmpty(_detail.Maintenance.MaintenanceTitle))
                                {
                                    <div class="small text-muted">@_detail.Maintenance.MaintenanceTitle</div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-muted small mb-2">Bakım modu aktif değil.</div>
                        }
                        <a href="/tenants/@TenantId/maintenance" class="btn btn-outline-warning btn-sm">
                            🔧 Bakım Modunu Yönet
                        </a>
                    }

                    @if (_tab == "Diller")
                    {
                        <div class="small fw-semibold text-muted mb-2">AKTİF DİLLER</div>
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @foreach (var l in _editLangs)
                            {
                                var lang = l;
                                <div class="d-flex align-items-center gap-1 px-2 py-1 rounded"
                                     style="border:1px solid var(--border);background:var(--surface-2)">
                                    <span class="fw-medium" style="font-size:12px">@lang.ToUpper()</span>
                                    @if (lang == _defaultLang)
                                    {
                                        <span class="badge bg-primary" style="font-size:9px">Varsayılan</span>
                                    }
                                    else
                                    {
                                        <button class="btn-close" style="font-size:8px"
                                                @onclick="() => _editLangs.Remove(lang)"></button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-2 mb-3">
                            <input @bind="_newLang" type="text" class="form-control form-control-sm"
                                   maxlength="5" placeholder="ör: de" style="max-width:100px" />
                            <button class="btn btn-outline-secondary btn-sm" @onclick="AddLang"
                                    disabled="@string.IsNullOrWhiteSpace(_newLang)">
                                + Ekle
                            </button>
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-medium">Varsayılan Dil</label>
                            <select class="form-select form-select-sm" style="max-width:160px" @bind="_defaultLang">
                                @foreach (var l in _editLangs)
                                {
                                    <option value="@l">@l.ToUpper()</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-primary btn-sm" @onclick="SaveLangsAsync" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Dilleri Kaydet
                        </button>
                    }

                    @if (_tab == "Kullanıcılar")
                    {
                        @if (!_detail.Users.Any())
                        {
                            <div class="text-center py-5 text-muted small">Bu tenant'a atanmış kullanıcı yok.</div>
                        }
                        else
                        {
                            <table class="table table-sm table-hover mb-0" style="font-size:13px">
                                <thead>
                                    <tr>
                                        <th class="text-muted fw-medium border-0" style="font-size:11px">Kullanıcı</th>
                                        <th class="text-muted fw-medium border-0" style="font-size:11px">Roller</th>
                                        <th class="text-muted fw-medium border-0" style="font-size:11px">Son Giriş</th>
                                        <th class="text-muted fw-medium border-0" style="font-size:11px">Durum</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in _detail.Users)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-medium">@(u.DisplayName ?? u.Email)</div>
                                                <div class="text-muted" style="font-size:10px">@u.Email</div>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-1 flex-wrap">
                                                    @foreach (var r in u.Roles)
                                                    {
                                                        <span class="badge bg-light text-dark" style="font-size:9px">@r</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-muted">
                                                @(u.LastLogin?.ToLocalTime().ToString("dd MMM HH:mm") ?? "—")
                                            </td>
                                            <td>
                                                <span class="badge @(u.IsActive ? "bg-success" : "bg-secondary")"
                                                      style="font-size:9px">
                                                    @(u.IsActive ? "Aktif" : "Pasif")
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@if (_confirmDeact)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1040" @onclick="() => _confirmDeact = false"></div>
    <div class="modal fade show d-block" tabindex="-1" style="z-index:1050">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header border-0 pb-1">
                    <h6 class="modal-title fw-semibold text-danger">⚠️ Tenant'ı Devre Dışı Bırak</h6>
                    <button class="btn-close btn-close-sm" @onclick="() => _confirmDeact = false"></button>
                </div>
                <div class="modal-body py-2 small">
                    <strong>@_detail?.Name</strong> tenant'ındaki tüm kullanıcılar erişimini kaybeder.
                </div>
                <div class="modal-footer border-0 gap-2">
                    <button class="btn btn-sm btn-ghost" @onclick="() => _confirmDeact = false">İptal</button>
                    <button class="btn btn-sm btn-danger" @onclick="DeactivateAsync" disabled="@_busy">
                        @if (_busy)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        Devre Dışı Bırak
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid TenantId { get; set; }
    string _search = "";

    TenantDetailDto? _detail;
    string _tab = "Genel";
    string? _editName, _newLang;
    List<string> _editLangs = [];
    string _defaultLang = "tr";

    bool _loading = true, _busy, _confirmDeact;
    string? _error;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true; _error = null;
        StateHasChanged();
        try
        {
            // SuperAdminApiClient.GetTenantDetailAsync → TenantDetailDto
            var r = await SuperAdminApiClient.GetTenantDetailAsync(TenantId);
            if (!r.IsSuccess) { _error = r.Error!.Message; return; }
            _detail = r.Data!;
            _editName = _detail.Name;
            _editLangs = [.. _detail.Languages];
            _defaultLang = _detail.DefaultLanguage;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    void AddLang()
    {
        var code = _newLang?.Trim().ToLower();
        if (string.IsNullOrEmpty(code) || _editLangs.Contains(code)) return;
        _editLangs.Add(code); _newLang = null;
    }

    async Task SaveNameAsync()
    {
        if (string.IsNullOrWhiteSpace(_editName)) return;
        _busy = true;
        try
        {
            // TenantApiClient.UpdateTenantAsync(id, UpdateTenantNameRequest)
            var r = await TenantApiClient.UpdateTenantAsync(TenantId, new UpdateTenantNameRequest(_editName!));
            if (r.IsSuccess) { Toast.Success("Tenant adı güncellendi."); await LoadAsync(); }
            else { Toast.Error(r.Error!.Message); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _busy = false; }
    }

    async Task SaveLangsAsync()
    {
        _busy = true;
        try
        {
            // TenantApiClient.UpdateTenantLanguagesAsync(id, UpdateLanguagesApiRequest)
            var req = new UpdateLanguagesApiRequest(_editLangs, _defaultLang);
            var r = await TenantApiClient.UpdateTenantLanguagesAsync(TenantId, req);
            if (r.IsSuccess) { Toast.Success("Diller güncellendi."); await LoadAsync(); }
            else { Toast.Error(r.Error!.Message); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _busy = false; }
    }

    async Task DeactivateAsync()
    {
        _busy = true; _confirmDeact = false;
        try
        {
            // SuperAdminApiClient.SetTenantActiveAsync(tenantId, SetTenantActiveRequest)
            var r = await SuperAdminApiClient.SetTenantActiveAsync(TenantId, new SetTenantActiveRequest(false));
            if (r.IsSuccess) { Toast.Warning("Tenant devre dışı bırakıldı."); await LoadAsync(); }
            else { Toast.Error(r.Error!.Message); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { _busy = false; }
    }
}
