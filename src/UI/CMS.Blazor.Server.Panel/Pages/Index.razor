@page "/"
@attribute [Authorize]
@layout DashBoardLayout

<PageTitle>Analytics Dashboard — CMS</PageTitle>
@if (!AppState.Session.Can("content.read"))
{
    <AccessDenied />
    return;
}

<div class="dash-content-toolbar">
    <div class="left-panel d-flex align-items-center gap-3">
        <span class="cms-page-title">Kullanıcılar</span>
        <div class="dash-header-sep"></div>
        <button class="btn btn-primary btn-sm d-flex align-items-center gap-1" @onclick="OpenAdd">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16"><path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" /></svg>
            Kullanıcı Ekle
        </button>
    </div>
    <div class="right-panel">
    </div>
    <div class="d-flex align-items-center gap-2">
        <SearchBox @bind-Value="_search" />
        <IconButton Icon="icon-refresh" OnClick="LoadAsync" />
    </div>
</div>

<div class="dash-content">
    <div class="dash-content-inner">
    </div>
</div>

@if (_loading)
{
    <div class="text-center p-5">
        <div class="spinner-border" style="width:1.5rem;height:1.5rem;color:var(--accent)"></div>
    </div>
}
else
{
    <div class="dash-content-toolbar">
        <div class="left-panel d-flex align-items-center gap-3">
            <span class="cms-page-title">İstatistikler</span>
            <small class="text-muted">@AppState.Session.CurrentTenantName — Son 30 gün</small>
            <div class="dash-header-sep"></div>
        </div>
        <div class="right-panel">
            <button class="btn-ghost btn-icon" title="Yenile" @onclick="LoadAsync">
                <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                    <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
                </svg>
            </button>
        </div>
    </div>

    <div class="dash-content">
        <div class="dash-content-inner">

            <!-- ── KPI Şeridi ───────────────────────────────────────────────── -->
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:#ede9fe;color:#7c3aed">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm-.5 2.5A.5.5 0 0 1 5 6h6a.5.5 0 0 1 0 1H5a.5.5 0 0 1-.5-.5zM5 8a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z" />
                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z" />
                            </svg>
                        </div>
                        <div class="kpi-body">
                            <div class="kpi-value">@_totalContents</div>
                            <div class="kpi-label">Toplam İçerik</div>
                            <div class="kpi-delta @(_deltaContents >= 0 ? "positive" : "negative")">
                                @(_deltaContents >= 0 ? "▲" : "▼") @Math.Abs(_deltaContents) bu hafta
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:#dcfce7;color:#15803d">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                            </svg>
                        </div>
                        <div class="kpi-body">
                            <div class="kpi-value">@_published</div>
                            <div class="kpi-label">Yayında</div>
                            <div class="kpi-delta positive">%@PublishRate yayın oranı</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:#fef9c3;color:#a16207">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z" />
                                <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z" />
                            </svg>
                        </div>
                        <div class="kpi-body">
                            <div class="kpi-value">@_scheduled</div>
                            <div class="kpi-label">Zamanlandı</div>
                            <div class="kpi-delta" style="color:var(--text-3)">@_nextScheduled</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="kpi-card">
                        <div class="kpi-icon" style="background:#fee2e2;color:#b91c1c">
                            <svg width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6z" />
                                <path fill-rule="evenodd" d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3V2h11v1z" />
                            </svg>
                        </div>
                        <div class="kpi-body">
                            <div class="kpi-value">@_trashed</div>
                            <div class="kpi-label">Çöp Kutusu</div>
                            <div class="kpi-delta" style="color:var(--text-3)">Kalıcı silme bekliyor</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <!-- İçerik Durumu Bar Chart -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent py-2 px-3">
                            <span class="fw-semibold small">İçerik Durum Dağılımı</span>
                        </div>
                        <div class="card-body py-3">
                            @foreach (var s in _statusDist)
                            {
                                var pct = _totalContents == 0 ? 0 : (int)Math.Round(s.Count * 100.0 / _totalContents);
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <div style="width:8px;height:8px;border-radius:2px;background:@s.Color"></div>
                                            <span class="small">@s.Label</span>
                                        </div>
                                        <span class="small fw-medium">@s.Count <span class="text-muted">(@pct%)</span></span>
                                    </div>
                                    <div style="height:6px;background:var(--surface-3);border-radius:3px">
                                        <div style="height:100%;width:@(pct)%;background:@s.Color;border-radius:3px;transition:.5s ease"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- İçerik Türü Pasta Grafik (SVG) -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent py-2 px-3">
                            <span class="fw-semibold small">İçerik Türleri</span>
                        </div>
                        <div class="card-body d-flex flex-column align-items-center justify-content-center">
                            @if (_typeDist.Any())
                            {
                                <svg viewBox="0 0 120 120" width="120" height="120">
                                    @{
                                        double startAngle = -90;
                                        var total = (double)_typeDist.Sum(t => t.Count);
                                        string[] typeColors = ["#625f98", "#22c55e", "#f59e0b", "#ef4444", "#3b82f6"];
                                        int ci = 0;
                                    }
                                    @foreach (var type in _typeDist)
                                    {
                                        var sweep = type.Count / total * 360;
                                        var x1 = 60 + 50 * Math.Cos(startAngle * Math.PI / 180);
                                        var y1 = 60 + 50 * Math.Sin(startAngle * Math.PI / 180);
                                        startAngle += sweep;
                                        var x2 = 60 + 50 * Math.Cos(startAngle * Math.PI / 180);
                                        var y2 = 60 + 50 * Math.Sin(startAngle * Math.PI / 180);
                                        var large = sweep > 180 ? 1 : 0;
                                        var color = typeColors[ci++ % typeColors.Length];
                                        <path d="M60,60 L@x1.ToString(" F1"),@y1.ToString("F1") A50,50 0 @large,1 @x2.ToString("F1"),@y2.ToString("F1") Z"
                                              fill="@color" />
                                    }
                                    <circle cx="60" cy="60" r="30" fill="var(--surface-0)" />
                                    <text x="60" y="55" text-anchor="middle" style="font-size:10px;fill:var(--text-3)">Toplam</text>
                                    <text x="60" y="70" text-anchor="middle" style="font-size:14px;font-weight:700;fill:var(--text-1)">@_totalContents</text>
                                </svg>
                                <div class="mt-3 w-100">
                                    @{
                                        ci = 0;
                                    }
                                    @foreach (var type in _typeDist)
                                    {
                                        var color = typeColors[ci++ % typeColors.Length];
                                        <div class="d-flex align-items-center justify-content-between mb-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <div style="width:8px;height:8px;border-radius:2px;background:@color"></div>
                                                <span class="small">@type.Label</span>
                                            </div>
                                            <span class="small text-muted">@type.Count</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted small text-center py-4">Veri yok</p>
                            }
                        </div>
                    </div>
                </div>

                <!-- Dil Tamamlanma Skoru -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent py-2 px-3">
                            <span class="fw-semibold small">Dil Kapsamı</span>
                        </div>
                        <div class="card-body py-3">
                            @foreach (var lang in _langCoverage)
                            {
                                <div class="mb-3">
                                    <div class="d-flex align-items-center justify-content-between mb-1">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-secondary" style="font-size:10px;min-width:28px">@lang.Code.ToUpper()</span>
                                            @if (lang.IsDefault)
                                            {
                                                <span class="badge bg-primary" style="font-size:9px">Varsayılan</span>
                                            }
                                        </div>
                                        <span class="small fw-semibold" style="color:@ScoreColor(lang.Pct)">@lang.Pct%</span>
                                    </div>
                                    <div style="height:8px;background:var(--surface-3);border-radius:4px">
                                        <div style="height:100%;width:@(lang.Pct)%;background:@ScoreColor(lang.Pct);border-radius:4px;transition:.5s ease"></div>
                                    </div>
                                    <div class="d-flex justify-content-between mt-1">
                                        <small class="text-muted" style="font-size:10px">@lang.Done içerik çevrildi</small>
                                        @if (lang.Missing > 0)
                                        {
                                            <a href="/translations?lang=@lang.Code" class="text-danger" style="font-size:10px">
                                                @lang.Missing eksik →
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            @if (!_langCoverage.Any())
                            {
                                <p class="text-muted small text-center py-3">Dil verisi yok</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── İçerik Aktivitesi Timeline ─────────────────────────────── -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-lg-8">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-transparent py-2 px-3 d-flex justify-content-between">
                            <span class="fw-semibold small">İçerik Aktivitesi (30 Gün)</span>
                            <div class="d-flex gap-3 align-items-center">
                                <div class="d-flex align-items-center gap-1">
                                    <div style="width:8px;height:8px;background:#625f98;border-radius:2px"></div>
                                    <span style="font-size:10px;color:var(--text-3)">Oluşturulan</span>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    <div style="width:8px;height:8px;background:#22c55e;border-radius:2px"></div>
                                    <span style="font-size:10px;color:var(--text-3)">Yayınlanan</span>
                                </div>
                            </div>
                        </div>
                        <div class="card-body p-3" style="height:200px">
                            <!-- Mini sparkline chart using SVG -->
                            <svg width="100%" height="100%" viewBox="0 0 400 160" preserveAspectRatio="none">
                                <!-- Grid lines -->
                                @for (int g = 0; g <= 4; g++)
                                {
                                    var yg = 10 + g * 35;
                                    <line x1="0" y1="@yg" x2="400" y2="@yg" stroke="var(--border)" stroke-width="0.5" />
                                }
                                <!-- Created area -->
                                <polyline points="@SparklinePoints(_activityData.Select(d => (double)d.Created).ToList(), 400, 150)"
                                          fill="none" stroke="#625f98" stroke-width="2" />
                                <!-- Published area -->
                                <polyline points="@SparklinePoints(_activityData.Select(d => (double)d.Published).ToList(), 400, 150)"
                                          fill="none" stroke="#22c55e" stroke-width="2" stroke-dasharray="4,2" />
                                <!-- Date labels (every 7 days) -->
                                @for (int i = 0; i < _activityData.Count; i += 7)
                                {
                                    var x = (double)i / Math.Max(1, _activityData.Count - 1) * 390 + 5;
                                    <span x="@x" y="158" text-anchor="middle" style="font-size:8px;fill:var(--text-3);">
                                        @(_activityData[i].Date.ToString("dd/MM"))
                                    </span>
                                }
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- En Aktif Kullanıcılar -->
                <div class="col-12 col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-transparent py-2 px-3">
                            <span class="fw-semibold small">En Aktif Kullanıcılar</span>
                        </div>
                        <div class="card-body p-0">
                            @foreach (var (user, count, i) in _topUsers.Select((u, i) => (u.Email, u.Count, i)))
                            {
                                <div class="d-flex align-items-center gap-2 px-3 py-2 border-bottom">
                                    <div class="fw-bold text-muted" style="width:16px;font-size:11px">@(i + 1)</div>
                                    <div class="avatar-sm" style="background:var(--brand-light);color:var(--accent);width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0">
                                        @user.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="flex-fill">
                                        <div class="small fw-medium" style="font-size:11px">@(user.Length > 22 ? user[..20] + "…" : user)</div>
                                    </div>
                                    <span class="badge bg-secondary" style="font-size:10px">@count</span>
                                </div>
                            }
                            @if (!_topUsers.Any())
                            {
                                <p class="text-muted small text-center py-4">Veri yok</p>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Audit Insights ─────────────────────────────────────────── -->
            @if (AppState.Session.Can("tenants.manage"))
            {
                <div class="row g-3">
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-transparent py-2 px-3 d-flex justify-content-between">
                                <span class="fw-semibold small">Son Audit Kayıtları</span>
                                <a href="/audit-logs" class="btn btn-link btn-sm p-0 small">Tümü →</a>
                            </div>
                            <div class="card-body p-0">
                                @foreach (var log in _recentLogs)
                                {
                                    <div class="d-flex align-items-start gap-2 px-3 py-2 border-bottom">
                                        <div class="audit-dot mt-1" style="background:@AuditColor(log.Action)"></div>
                                        <div class="flex-fill">
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="small fw-medium" style="font-size:12px">@log.Action</span>
                                                <span class="badge bg-light text-dark border" style="font-size:9px">@log.EntityType</span>
                                            </div>
                                            <div class="text-muted" style="font-size:10px">@log.UserEmail</div>
                                        </div>
                                        <small class="text-muted text-nowrap" style="font-size:10px">
                                            @log.CreatedAt.ToString("HH:mm")
                                        </small>
                                    </div>
                                }
                                @if (!_recentLogs.Any())
                                {
                                    <p class="text-muted small text-center py-4">Audit kaydı yok</p>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-transparent py-2 px-3">
                                <span class="fw-semibold small">İşlem Dağılımı (Audit)</span>
                            </div>
                            <div class="card-body py-3">
                                @foreach (var g in _auditGroups)
                                {
                                    var pct = _recentLogs.Count == 0 ? 0 : (int)Math.Round(g.Count * 100.0 / Math.Max(1, _recentLogs.Count));
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <div class="audit-dot" style="background:@AuditColor(g.Action);flex-shrink:0"></div>
                                        <span class="small" style="min-width:100px">@g.Action</span>
                                        <div class="flex-fill" style="height:6px;background:var(--surface-3);border-radius:3px">
                                            <div style="height:100%;width:@(pct)%;background:@AuditColor(g.Action);border-radius:3px;transition:.5s"></div>
                                        </div>
                                        <span class="text-muted" style="font-size:11px;font-family:monospace">@g.Count</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .kpi-card {
        display: flex;
        align-items: center;
        gap: 14px;
        background: var(--surface-0);
        border: 1px solid var(--border);
        border-radius: var(--r-lg);
        padding: 16px;
        box-shadow: var(--shadow-sm);
        transition: box-shadow .2s;
    }

        .kpi-card:hover {
            box-shadow: var(--shadow);
        }

    .kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: var(--r-md);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .kpi-body {
        flex: 1;
    }

    .kpi-value {
        font-size: 1.6rem;
        font-weight: 700;
        line-height: 1;
        color: var(--text-1);
    }

    .kpi-label {
        font-size: 12px;
        color: var(--text-3);
        margin-top: 2px;
    }

    .kpi-delta {
        font-size: 10px;
        margin-top: 4px;
    }

        .kpi-delta.positive {
            color: #15803d;
        }

        .kpi-delta.negative {
            color: #b91c1c;
        }

    .audit-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
    }
</style>

@code {
    bool _loading = true;
    int _totalContents, _published, _scheduled, _trashed, _deltaContents;
    string _nextScheduled = "—";
    string _search = "";

    List<StatusCount> _statusDist = [];
    List<TypeCount> _typeDist = [];
    List<LangCoverage> _langCoverage = [];
    List<ActivityDay> _activityData = [];
    List<UserActivity> _topUsers = [];
    List<AuditLogDto> _recentLogs = [];
    List<AuditGroup> _auditGroups = [];

    int PublishRate => _totalContents == 0 ? 0 : (int)Math.Round(_published * 100.0 / _totalContents);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await PermSync.SyncIfNeededAsync();
        await LoadAsync();
        StateHasChanged();
    }

    async Task LoadAsync()
    {
        _loading = true;

        // Contents
        if (AppState.Session.Can("content.read"))
        {
            var all = await ContentApiClient.GetContentsAsync(0, 200);
            if (all.IsSuccess && all.Data?.Items is not null)
            {
                var items = all.Data.Items;
                _totalContents = all.Data.Count;

                _published = items.Count(i => i.Status == "Published");
                _scheduled = items.Count(i => i.Status == "Scheduled");

                _statusDist =
                [
                    new("Yayında", _published, "#22c55e"),
                    new("Taslak", items.Count(i => i.Status == "Draft"), "#625f98"),
                    new("Zamanlandı", _scheduled, "#f59e0b"),
                    new("Arşiv", items.Count(i => i.Status == "Archived"), "#64748b"),
                    new("Süresi Doldu", items.Count(i => i.Status == "Expired"), "#ef4444"),
                ];

                _typeDist = items
                    .GroupBy(i => i.ContentType)
                    .Select(g => new TypeCount(g.Key, g.Count()))
                    .OrderByDescending(t => t.Count).ToList();

                // Language coverage
                var allLangs = items.SelectMany(i => i.Languages).Distinct().OrderBy(x => x).ToList();
                _langCoverage = allLangs.Select(l => new LangCoverage(
                    l, l == "tr",
                    items.Count(i => i.Languages.Contains(l)),
                    items.Count)).ToList();

                // Activity last 30 days (simulated from createdAt)
                var base30 = DateTime.Today.AddDays(-29);
                _activityData = Enumerable.Range(0, 30).Select(d =>
                {
                    var date = DateOnly.FromDateTime(base30.AddDays(d));
                    return new ActivityDay(date,
                        items.Count(i => DateOnly.FromDateTime(i.CreatedAt) == date),
                        items.Count(i => i.Status == "Published" && i.UpdatedAt.HasValue &&
                                        DateOnly.FromDateTime(i.UpdatedAt.Value) == date));
                }).ToList();

                _deltaContents = items.Count(i => i.CreatedAt >= DateTime.UtcNow.AddDays(-7));
            }

            if (AppState.Session.Can("content.readDeleted"))
            {
                var trash = await ContentApiClient.GetTrashAsync();
                if (trash.IsSuccess) _trashed = trash.Data?.Count ?? 0;
            }
        }

        // Audit logs
        if (AppState.Session.Can("tenants.manage"))
        {
            var logs = await AuditApiClient.GetAuditLogsAsync(pageSize: 50);
            if (logs.IsSuccess && logs.Data?.Items is not null)
            {
                _recentLogs = logs.Data.Items.Take(8).ToList();
                _auditGroups = logs.Data.Items
                    .GroupBy(l => l.Action)
                    .Select(g => new AuditGroup(g.Key, g.Count()))
                    .OrderByDescending(g => g.Count).Take(6).ToList();

                _topUsers = logs.Data.Items
                    .GroupBy(l => l.UserEmail)
                    .Select(g => new UserActivity(g.Key, g.Count()))
                    .OrderByDescending(u => u.Count).Take(6).ToList();
            }
        }

        _loading = false;
    }

    static string SparklinePoints(List<double> values, int width, int height)
    {
        if (!values.Any()) return "";
        var max = values.Max();
        if (max == 0) return "";
        var points = values.Select((v, i) =>
        {
            var x = (double)i / Math.Max(1, values.Count - 1) * (width - 10) + 5;
            var y = height - (v / max * (height - 20) + 5);
            return $"{x:F1},{y:F1}";
        });
        return string.Join(" ", points);
    }

    static string ScoreColor(int s) => s >= 80 ? "#15803d" : s >= 50 ? "#d97706" : "#dc2626";

    static string AuditColor(string action) => action.ToLower() switch
    {
        var a when a.Contains("delete") || a.Contains("remove") => "#ef4444",
        var a when a.Contains("create") || a.Contains("add") => "#22c55e",
        var a when a.Contains("publish") => "#8b5cf6",
        var a when a.Contains("login") || a.Contains("logout") => "#3b82f6",
        var a when a.Contains("update") || a.Contains("edit") => "#f59e0b",
        _ => "#64748b",
    };

    sealed record StatusCount(string Label, int Count, string Color);
    sealed record TypeCount(string Label, int Count);
    sealed record LangCoverage(string Code, bool IsDefault, int Done, int Total)
    {
        public int Pct => Total == 0 ? 100 : (int)Math.Round(Done * 100.0 / Total);
        public int Missing => Total - Done;
    }
    sealed record ActivityDay(DateOnly Date, int Created, int Published);
    sealed record UserActivity(string Email, int Count);
    sealed record AuditGroup(string Action, int Count);
}
