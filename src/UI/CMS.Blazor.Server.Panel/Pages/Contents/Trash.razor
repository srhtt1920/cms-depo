@page "/contents/trash"
@attribute [Authorize]
@layout DashBoardLayout

<PageTitle>Çöp Kutusu — CMS</PageTitle>
@if (!AppState.Session.Can("content.readDeleted"))
{
    <AccessDenied />
    return;
}

<PageHeader Title="Çöp Kutusu">
    <Actions>
        @if (_selected.Any() && AppState.Session.Can("content.hardDelete"))
        {
            <button class="btn btn-danger btn-sm" @onclick="BulkHardDelete" disabled="@_busy">
                @_selected.Count seçiliyi Kalıcı Sil
            </button>
        }
        @if (_selected.Any() && AppState.Session.Can("content.restore"))
        {
            <button class="btn btn-outline-success btn-sm" @onclick="BulkRestore" disabled="@_busy">
                @_selected.Count seçiliyi Geri Al
            </button>
        }
        <button class="btn-ghost btn-icon" @onclick="LoadAsync" title="Yenile">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z" />
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z" />
            </svg>
        </button>
    </Actions>
</PageHeader>

<div class="alert alert-warning small py-2 mb-3 d-flex align-items-center gap-2">
    <svg width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
    </svg>
    Silinen içerikler 30 gün içinde kalıcı olarak silinir. <strong class="ms-1">Geri Al</strong> veya <strong>Kalıcı Sil</strong> seçeneklerini kullanın.
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger py-2 small mb-3">@_error <button class="btn btn-link btn-sm" @onclick="LoadAsync">Tekrar dene</button></div>
}
@if (!string.IsNullOrEmpty(_success))
{
    <div class="alert alert-success py-2 small mb-3">@_success</div>
}

@if (_loading)
{
    <div class="text-center p-5"><div class="spinner-border" style="width:1.5rem;height:1.5rem;color:var(--accent)"></div></div>
}
else
{
    <!-- Özet -->
    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
        <small class="text-muted">Toplam <strong>@_items.Count</strong> silinmiş içerik</small>
        @if (_selected.Any())
        {
            <small class="text-primary fw-medium">@_selected.Count seçili</small>
        }
        <div class="ms-auto">
            <input @bind="_search" @bind:event="oninput" type="text"
                   class="form-control form-control-sm" style="max-width:200px"
                   placeholder="Ara..." />
        </div>
    </div>

    <div class="cms-table-wrap">
        <table class="cms-table">
            <thead>
                <tr>
                    <th class="col-check">
                        <input type="checkbox" class="form-check-input"
                               @onchange="e => ToggleAll((bool)e.Value!)" />
                    </th>
                    <th><div class="th-inner">Başlık / Slug</div></th>
                    <th><div class="th-inner">Diller</div></th>
                    <th><div class="th-inner">Tamamlanma</div></th>
                    <th><div class="th-inner">Silinme</div></th>
                    <th style="width:160px"></th>
                </tr>
            </thead>
            <tbody>
                @if (Filtered.Any())
                {
                    @foreach (var c in Filtered)
                    {
                        <tr class="@(_selected.Contains(c.Id) ? "selected" : "")">
                            <td class="col-check" @onclick:stopPropagation>
                                <input type="checkbox" class="form-check-input"
                                       checked="@_selected.Contains(c.Id)"
                                       @onchange="e => Toggle(c.Id, (bool)e.Value!)" />
                            </td>
                            <td>
                                <div style="font-weight:500;color:var(--text-2)">@c.Title</div>
                                <div class="mono" style="font-size:11px;color:var(--text-3)">/&thinsp;@c.Slug</div>
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var l in c.Languages)
                                    {
                                        <span class="badge" style="background:var(--surface-2);color:var(--text-2);font-size:10px">@l.ToUpper()</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (_completions.TryGetValue(c.Id, out var comp))
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="flex:1;height:4px;background:var(--surface-2);border-radius:2px;overflow:hidden;max-width:60px">
                                            <div style="height:100%;width:@(comp)%;background:@ScoreColor(comp);border-radius:2px"></div>
                                        </div>
                                        <span class="mono" style="font-size:10px;color:@ScoreColor(comp)">@comp%</span>
                                    </div>
                                }
                                else
                                {
                                    <div style="height:4px;background:var(--surface-2);border-radius:2px;max-width:60px;opacity:.5"></div>
                                }
                            </td>
                            <td>
                                <small class="text-muted">
                                    @(c.DeletedAt?.ToString("dd MMM yyyy") ?? "—")
                                </small>
                            </td>
                            <td @onclick:stopPropagation>
                                <div class="d-flex gap-1 justify-content-end">
                                    @if (AppState.Session.Can("content.restore"))
                                    {
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => Restore(c.Id)" disabled="@_busy">
                                            Geri Al
                                        </button>
                                    }
                                    @if (AppState.Session.Can("content.hardDelete"))
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmHardDelete(c)"
                                                disabled="@_busy">
                                            Kalıcı Sil
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                 style="opacity:.3;display:block;margin:0 auto 8px">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Çöp kutusu boş
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Kalıcı silme onay modalı -->
@if (_deleteTarget is not null)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.45)" @onclick="() => _deleteTarget = null">
        <div class="modal-dialog modal-sm" @onclick:stopPropagation>
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-body py-4 text-center">
                    <div class="mb-3">
                        <svg width="36" height="36" fill="var(--red)" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                    </div>
                    <div class="fw-semibold mb-1">Kalıcı olarak silinsin mi?</div>
                    <div class="text-muted small mb-1"><strong>@_deleteTarget.Title</strong></div>
                    <div class="text-danger small mb-3">Bu işlem geri alınamaz!</div>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-outline-secondary btn-sm" @onclick="() => _deleteTarget = null">İptal</button>
                        <button class="btn btn-danger btn-sm" @onclick="DoHardDelete" disabled="@_busy">
                            @if (_busy)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            Kalıcı Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    List<TrashItemDto> _items = [];
    Dictionary<Guid, int> _completions = [];
    HashSet<Guid> _selected = [];
    TrashItemDto? _deleteTarget;
    string _search = "";
    bool _loading, _busy;
    string _error = "", _success = "";

    List<TrashItemDto> Filtered => string.IsNullOrEmpty(_search)
        ? _items
        : _items.Where(x =>
            x.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            x.Slug.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        _loading = true; _error = ""; _success = ""; _selected.Clear(); StateHasChanged();
        var r = await ContentApiClient.GetTrashAsync();
        if (r.IsSuccess && r.Data is not null)
        {
            _items = r.Data;
            _ = LoadCompletionsAsync(_items.Select(x => x.Id).ToList());
        }
        else Toast.Error(r.Error?.Message ?? "Çöp kutusu yüklenemedi.");
        _loading = false;
        StateHasChanged();
    }

    async Task LoadCompletionsAsync(List<Guid> ids)
    {
        var tasks = ids.Select(id => ContentApiClient.GetCompletionAsync(id)).ToList();
        var results = await Task.WhenAll(tasks);

        for (var i = 0; i < ids.Count; i++)
        {
            var r = results[i];
            if (r.IsSuccess && r.Data is not null)
                _completions[ids[i]] = r.Data.OverallScore;
        }
        await InvokeAsync(StateHasChanged);
    }

    async Task Restore(Guid id)
    {
        _busy = true; _error = "";
        var r = await ContentApiClient.RestoreContentAsync(id);
        if (r.IsSuccess) { _success = "İçerik geri alındı."; await LoadAsync(); }
        else Toast.Error(r.Error?.Message ?? "Geri alma başarısız.");
        _busy = false;
    }

    void ConfirmHardDelete(TrashItemDto item) => _deleteTarget = item;

    async Task DoHardDelete()
    {
        if (_deleteTarget is null) return;
        _busy = true; _error = "";
        var r = await ContentApiClient.HardDeleteContentAsync(_deleteTarget.Id);
        if (r.IsSuccess) { _success = $"'{_deleteTarget.Title}' kalıcı silindi."; _deleteTarget = null; await LoadAsync(); }
        else Toast.Error(r.Error?.Message ?? "Silme başarısız.");
        _busy = false;
    }

    async Task BulkRestore()
    {
        _busy = true; _error = ""; _success = "";
        var ids = _selected.ToList();
        var failed = 0;
        foreach (var id in ids)
        {
            var r = await ContentApiClient.RestoreContentAsync(id);
            if (!r.IsSuccess) failed++;
        }
        _success = $"{ids.Count - failed} içerik geri alındı.{(failed > 0 ? $" {failed} başarısız." : "")}";
        _busy = false;
        await LoadAsync();
    }

    async Task BulkHardDelete()
    {
        _busy = true; _error = ""; _success = "";
        var ids = _selected.ToList();
        var failed = 0;
        foreach (var id in ids)
        {
            var r = await ContentApiClient.HardDeleteContentAsync(id);
            if (!r.IsSuccess) failed++;
        }
        _success = $"{ids.Count - failed} içerik kalıcı silindi.{(failed > 0 ? $" {failed} başarısız." : "")}";
        _busy = false;
        await LoadAsync();
    }

    void Toggle(Guid id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }
    void ToggleAll(bool on)
    {
        if (on) foreach (var c in Filtered) _selected.Add(c.Id);
        else _selected.Clear();
    }

    static string ScoreColor(int p) => p >= 80 ? "var(--green)" : p >= 40 ? "var(--yellow,#f59e0b)" : "var(--red)";
}
