                </svg>
            </div>
            <div class="cms-splash-title">İçerik Yönetim Paneli</div>
            <div class="cms-splash-progress">
                <div class="cms-splash-progress-bar"></div>
            </div>
            <div class="cms-splash-msg">Sayfalar Yükleniyor...</div>
        </div>
    </div>
}
else
{
    <CascadingValue Value="AppState">
        <CascadingAuthenticationState>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(DashBoardLayout)">
                        <NotAuthorized>
                            @if (!AppState.Session.IsAuthenticated)
                            {
                                <RedirectToLogin />
                            }
                            else
                            {

                                <AccessDenied />
                            }
                        </NotAuthorized>
                        <Authorizing>
                            <div style="display:flex;justify-content:center;padding:60px">
                                <div class="spinner-border"
                                     style="color:var(--accent);width:1.75rem;height:1.75rem">
                                </div>
                            </div>
                        </Authorizing>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Sayfa Bulunamadı — CMS</PageTitle>
                    <LayoutView Layout="@typeof(DashBoardLayout)">
                        <NotFoundPage />
                    </LayoutView>
                </NotFound>
            </Router>
        </CascadingAuthenticationState>
    </CascadingValue>
}

@code {

    private bool _ready = false;
    private string _splashMsg = "Başlatılıyor...";
    private string _splashTheme = "light"; // cookie okunmadan önce default

    protected override void OnInitialized() =>
        AuthProvider.AuthenticationStateChanged += OnAuthChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // 1. Tema cookie'sini JS'den oku — splash'ı doğru temayla göster
        _splashMsg = "Tercihler yükleniyor...";
        StateHasChanged();

        await AppState.RestoreAsync();

        // Preferences restore oldu — splash temasını güncelle
        _splashTheme = AppState.Preferences.Theme;

        // 2. Session restore
        _splashMsg = "Oturum kontrol ediliyor...";
        StateHasChanged();
        await Task.Delay(1000); // minimal gecikme — akıcı geçiş için

        // 3. Hazır
        _ready = true;
        StateHasChanged();
    }

    private void OnAuthChanged(Task<AuthenticationState> _) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() =>
        AuthProvider.AuthenticationStateChanged -= OnAuthChanged;
}
