@implements IDisposable

<!-- Toast container - sağ alt köşede sabit konumlanır -->
<div class="toast-stack" aria-live="polite" aria-atomic="false">
    @foreach (var t in Toast.Toasts)
    {
        var toast = t;
        <div class="toast-item toast-item--@toast.Level.ToString().ToLower() @(_entering.Contains(toast.Id) ? "toast-item--enter" : "") @(_leaving.Contains(toast.Id) ? "toast-item--leave" : "")"
             role="alert"
             @key="toast.Id">

            <!-- İkon -->
            <div class="toast-icon">
                @switch (toast.Level)
                {
                    case ToastLevel.Success:
                        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
                            <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z" />
                        </svg>
                        break;
                    case ToastLevel.Error:
                        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z" />
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z" />
                        </svg>
                        break;
                    case ToastLevel.Warning:
                        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                        </svg>
                        break;
                    default:
                        <svg viewBox="0 0 16 16" fill="currentColor" width="16" height="16">
                            <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
                        </svg>
                        break;
                }
            </div>

            <!-- İçerik -->
            <div class="toast-body">
                <div class="toast-title">@toast.Title</div>
                <div class="toast-message">@toast.Message</div>
            </div>

            <!-- Kapat -->
            <button class="toast-close" @onclick="() => DismissAsync(toast)" aria-label="Kapat">
                <svg viewBox="0 0 16 16" fill="currentColor" width="10" height="10">
                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854z" />
                </svg>
            </button>

            <!-- Progress bar -->
            <div class="toast-progress"
                 style="animation-duration:@(toast.DurationMs)ms">
            </div>
        </div>
    }
</div>

<style>
    /* ── Container ─────────────────────────────────────────────────────────── */
    .toast-stack {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column-reverse;
        gap: 10px;
        pointer-events: none;
        max-width: 360px;
        width: calc(100vw - 48px);
    }

    /* ── Toast item ────────────────────────────────────────────────────────── */
    .toast-item {
        pointer-events: all;
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 13px 14px 16px;
        border-radius: 10px;
        background: var(--surface-1, #fff);
        border: 1px solid var(--border, #e5e7eb);
        box-shadow: 0 8px 24px rgba(0,0,0,.12), 0 2px 6px rgba(0,0,0,.06);
        position: relative;
        overflow: hidden;
        animation: toast-in 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    .toast-item--leave {
        animation: toast-out 0.25s ease-in forwards;
    }

    /* ── Color accents ─────────────────────────────────────────────────────── */
    .toast-item--success {
        border-left: 3px solid #22c55e;
    }

        .toast-item--success .toast-icon {
            color: #16a34a;
        }

        .toast-item--success .toast-progress {
            background: #22c55e;
        }

    .toast-item--error {
        border-left: 3px solid #ef4444;
    }

        .toast-item--error .toast-icon {
            color: #dc2626;
        }

        .toast-item--error .toast-progress {
            background: #ef4444;
        }

    .toast-item--warning {
        border-left: 3px solid #f59e0b;
    }

        .toast-item--warning .toast-icon {
            color: #d97706;
        }

        .toast-item--warning .toast-progress {
            background: #f59e0b;
        }

    .toast-item--info {
        border-left: 3px solid #3b82f6;
    }

        .toast-item--info .toast-icon {
            color: #2563eb;
        }

        .toast-item--info .toast-progress {
            background: #3b82f6;
        }

    /* ── Icon ──────────────────────────────────────────────────────────────── */
    .toast-icon {
        flex-shrink: 0;
        margin-top: 1px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ── Body ──────────────────────────────────────────────────────────────── */
    .toast-body {
        flex: 1;
        min-width: 0;
    }

    .toast-title {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-1, #111827);
        margin-bottom: 2px;
        line-height: 1.3;
    }

    .toast-message {
        font-size: 12px;
        color: var(--text-2, #6b7280);
        line-height: 1.5;
        word-break: break-word;
    }

    /* ── Close button ──────────────────────────────────────────────────────── */
    .toast-close {
        flex-shrink: 0;
        background: none;
        border: none;
        padding: 2px;
        cursor: pointer;
        color: var(--text-3, #9ca3af);
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color .15s, background .15s;
        margin-top: 1px;
    }

        .toast-close:hover {
            color: var(--text-1, #111827);
            background: var(--surface-2, #f3f4f6);
        }

    /* ── Progress bar ──────────────────────────────────────────────────────── */
    .toast-progress {
        position: absolute;
        bottom: 0;
        left: 0;
        height: 3px;
        width: 100%;
        transform-origin: left;
        animation: toast-progress linear forwards;
        opacity: .6;
        border-radius: 0 0 10px 10px;
    }

    /* ── Dark mode ─────────────────────────────────────────────────────────── */
    [data-bs-theme="dark"] .toast-item {
        background: #1e2130;
        border-color: #2d3148;
        box-shadow: 0 8px 24px rgba(0,0,0,.4), 0 2px 6px rgba(0,0,0,.2);
    }

    [data-bs-theme="dark"] .toast-title {
        color: #f1f5f9;
    }

    [data-bs-theme="dark"] .toast-message {
        color: #94a3b8;
    }

    [data-bs-theme="dark"] .toast-close {
        color: #64748b;
    }

        [data-bs-theme="dark"] .toast-close:hover {
            color: #f1f5f9;
            background: #2d3148;
        }

    /* ── Animations ────────────────────────────────────────────────────────── */
    @@keyframes toast-in {
        from {
            opacity: 0;
            transform: translateX(110%) scale(0.95);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }

    @@keyframes toast-out {
        from {
            opacity: 1;
            transform: translateX(0) scale(1);
            max-height: 120px;
            margin-bottom: 0;
        }

        to {
            opacity: 0;
            transform: translateX(110%) scale(0.9);
            max-height: 0;
            margin-bottom: -10px;
        }
    }

    @@keyframes toast-progress {
        from {
            transform: scaleX(1);
        }

        to {
            transform: scaleX(0);
        }
    }

    /* ── Mobile ────────────────────────────────────────────────────────────── */
    @@media (max-width: 480px) {
        .toast-stack {
            bottom: 16px;
            right: 12px;
            left: 12px;
            width: auto;
            max-width: 100%;
        }
    }
</style>

@code {
    private HashSet<Guid> _entering = [];
    private HashSet<Guid> _leaving = [];

    // Otomatik kapatma için timer'lar: toastId → timer
    private Dictionary<Guid, System.Threading.Timer> _timers = [];

    protected override void OnInitialized()
    {
        Toast.OnChanged += OnToastChanged;
    }

    private void OnToastChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();

            // Yeni gelen toast'ları tespit et ve zamanlayıcı başlat
            foreach (var t in Toast.Toasts)
            {
                if (!_timers.ContainsKey(t.Id))
                    ScheduleDismiss(t);
            }
        });
    }

    private void ScheduleDismiss(ToastMessage toast)
    {
        var timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() => DismissAsync(toast));
        }, null, toast.DurationMs, Timeout.Infinite);

        _timers[toast.Id] = timer;
    }

    private async Task DismissAsync(ToastMessage toast)
    {
        // Önce leave animasyonu başlat
        _leaving.Add(toast.Id);
        StateHasChanged();

        // Animasyon süresini bekle (250ms = toast-out süresiyle eşleşmeli)
        await Task.Delay(240);

        // Sonra servisten kaldır
        Toast.Dismiss(toast.Id);
        _leaving.Remove(toast.Id);
        _entering.Remove(toast.Id);

        // Timer'ı temizle
        if (_timers.TryGetValue(toast.Id, out var t))
        {
            t.Dispose();
            _timers.Remove(toast.Id);
        }

        StateHasChanged();
    }

    public void Dispose()
    {
        Toast.OnChanged -= OnToastChanged;
        foreach (var t in _timers.Values) t.Dispose();
        _timers.Clear();
    }
}