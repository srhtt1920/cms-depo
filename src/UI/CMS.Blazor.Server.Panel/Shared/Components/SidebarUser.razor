<div class="sidebar-user">
    <div class="sidebar-user-avatar" style="background:@Color">
        @Initial
    </div>
    <div class="sidebar-user-info">
        <div class="sidebar-user-email">@AppState.Session.Email</div>
        <div class="sidebar-user-role">Yönetici</div>
    </div>
    <button class="btn-ghost btn-icon sidebar-user-logout"
            @onclick="Logout" title="Çýkýþ">
        <SvgIcon Name="logout" Size="14" />
    </button>
</div>

@code {
    string Initial => AppState.Session.Email.Length > 0
        ? char.ToUpper(AppState.Session.Email[0]).ToString() : "?";

    string Color
    {
        get
        {
            string[] p = ["#6366f1", "#8b5cf6", "#ec4899", "#f59e0b", "#10b981", "#0ea5e9"];
            return p[Math.Abs(AppState.Session.Email.GetHashCode()) % p.Length];
        }
    }

    async Task Logout()
    {
        await AppState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}