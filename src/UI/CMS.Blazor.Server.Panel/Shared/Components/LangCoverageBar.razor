@* Shared/Components/LangCoverageBar.razor
   
   Contents listesinde her satırda dil kapsamı gösterir.
   Tenant'ın desteklediği diller yeşil (mevcut) / turuncu-kırmızı (eksik) badge olarak listelenir.
   
   Kullanım:
     <LangCoverageBar ExistingLanguages="@c.Languages" />
*@

@inject TenantLanguageState LangState
@implements IDisposable

<div class="d-flex gap-1 flex-wrap align-items-center">
    @foreach (var lang in _all)
    {
        var has = _existing.Contains(lang, StringComparer.OrdinalIgnoreCase);
        <span class="badge"
              style="font-size:9.5px;font-family:monospace;
                         background:@(has ? "rgba(16,185,129,.15)" : "rgba(239,68,68,.12)");
                         color:@(has ? "#065f46" : "#991b1b");
                         border:1px solid @(has ? "rgba(16,185,129,.35)" : "rgba(239,68,68,.3)")"
              title="@lang.ToUpper() — @(has ? "Mevcut" : "EKSİK")">
            @if (!has)
            {
                <svg width="7" height="7" fill="currentColor" viewBox="0 0 16 16" class="me-1">
                    <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
                </svg>
            }
            @lang.ToUpper()
        </span>
    }
    @if (!_all.Any())
    {
        @foreach (var lang in _existing.Take(4))
        {
            <span class="badge bg-secondary" style="font-size:9.5px">@lang.ToUpper()</span>
        }
    }
</div>

@code {
    [Parameter, EditorRequired]
    public IEnumerable<string> ExistingLanguages { get; set; } = [];

    List<string> _all = [];
    HashSet<string> _existing = [];

    protected override async Task OnInitializedAsync()
    {
        LangState.OnChanged += OnLangChanged;
        await LangState.EnsureLoadedAsync();
        Refresh();
    }

    protected override void OnParametersSet() => Refresh();

    void Refresh()
    {
        _existing = new HashSet<string>(ExistingLanguages, StringComparer.OrdinalIgnoreCase);
        _all = LangState.SupportedLanguages.Count > 0
            ? LangState.SupportedLanguages.ToList()
            : _existing.ToList();
    }

    void OnLangChanged() { Refresh(); InvokeAsync(StateHasChanged); }

    public void Dispose() => LangState.OnChanged -= OnLangChanged;
}
