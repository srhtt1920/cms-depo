<div class="dropdown">
    <button class="btn btn-sm btn-ghost dropdown-toggle px-2" type="button"
            data-bs-toggle="dropdown" title="Boyut modu">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
            <path d="M5.5 2A3.5 3.5 0 0 0 2 5.5v5A3.5 3.5 0 0 0 5.5 14h5a3.5 3.5 0 0 0 3.5-3.5v-5A3.5 3.5 0 0 0 10.5 2h-5zm0 1h5A2.5 2.5 0 0 1 13 5.5v5A2.5 2.5 0 0 1 10.5 13h-5A2.5 2.5 0 0 1 3 10.5v-5A2.5 2.5 0 0 1 5.5 3z"/>
        </svg>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="min-width:150px;font-size:.85rem">
        @foreach (var s in Sizes)
        {
            <li>
                <button class="dropdown-item @(AppState.Preferences.SizeMode == s.Key ? "active" : "")"
                        @onclick="() => Set(s.Key)">
                    @s.Label
                </button>
            </li>
        }
    </ul>
</div>

@code {
    record SizeOpt(string Key, string Label);
    static readonly SizeOpt[] Sizes =
    [
        new("default",     "Varsayılan"),
        new("compact",     "Kompakt"),
        new("comfortable", "Geniş"),
    ];
    private async Task Set(string v) => await AppState.SetSizeModeAsync(v);
}
