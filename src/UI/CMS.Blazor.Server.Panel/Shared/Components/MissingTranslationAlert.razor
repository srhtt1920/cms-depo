@* Shared/Components/MissingTranslationAlert.razor
   
   Kullanım:
     <MissingTranslationAlert ExistingLanguages="@_detail.Translations.Select(t => t.LanguageCode)"
                               OnAddTranslation="ShowAddTransModal" />
   
   Tenant destekli diller ile içerikteki mevcut dilleri karşılaştırır.
   Eksik varsa sarı uyarı banner'ı gösterir; her eksik dil için "Ekle" linki sunar.
*@

@inject TenantLanguageState LangState
@implements IDisposable

@if (_missing.Any())
{
    <div class="alert d-flex align-items-start gap-2 py-2 px-3 mb-3"
         style="background:rgba(245,158,11,.1);border:1px solid rgba(245,158,11,.35);border-radius:8px">

        <!-- İkon -->
        <svg width="15" height="15" fill="#d97706" viewBox="0 0 16 16" class="mt-1 flex-shrink-0">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" />
        </svg>

        <div style="flex:1;min-width:0">
            <div class="fw-semibold" style="font-size:13px;color:#92400e">
                Eksik çeviri — tenant bu dilleri destekliyor
            </div>
            <div class="d-flex flex-wrap gap-2 mt-1">
                @foreach (var lang in _missing)
                {
                    <div class="d-flex align-items-center gap-1">
                        <span class="badge"
                              style="background:#fef3c7;color:#92400e;border:1px solid #fcd34d;font-size:11px;font-family:monospace">
                            @lang.ToUpper()
                        </span>
                        @if (OnAddTranslation.HasDelegate)
                        {
                            <button class="btn btn-link btn-sm p-0"
                                    style="font-size:11px;color:#d97706;text-decoration:underline dotted"
                                    @onclick="() => OnAddTranslation.InvokeAsync(lang)">
                                + Ekle
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Kapat -->
        <button class="btn-ghost btn-icon" style="color:#d97706;flex-shrink:0"
                @onclick="() => _dismissed = true" title="Uyarıyı gizle">
            <svg width="12" height="12" fill="currentColor" viewBox="0 0 16 16">
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708z" />
            </svg>
        </button>
    </div>
}

@code {
    /// İçerikte halihazırda mevcut dil kodları (örn: ["tr","de"])
    [Parameter, EditorRequired]
    public IEnumerable<string> ExistingLanguages { get; set; } = [];

    /// Kullanıcı "Ekle" butonuna basınca tetiklenir; parametre: dil kodu
    [Parameter]
    public EventCallback<string> OnAddTranslation { get; set; }

    List<string> _missing = [];
    bool _dismissed;

    protected override async Task OnInitializedAsync()
    {
        LangState.OnChanged += Refresh;
        await LangState.EnsureLoadedAsync();
        Compute();
    }

    protected override void OnParametersSet()
    {
        if (!_dismissed) Compute();
    }

    void Refresh()
    {
        _dismissed = false;
        Compute();
        InvokeAsync(StateHasChanged);
    }

    void Compute() =>
        _missing = _dismissed ? [] : LangState.MissingIn(ExistingLanguages).ToList();

    public void Dispose() => LangState.OnChanged -= Refresh;
}
