<!-- Size seçici -->
<div class="dropdown">
    <button class="btn-ghost topbar-size-btn" type="button" data-bs-toggle="dropdown">
        @SizeName
        <SvgIcon Name="icon-chevron-down" Size="10" />
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="min-width:140px;font-size:13px">
        @foreach (var s in Sizes)
        {
            <li>
                <button class="dropdown-item @(AppState.Preferences.SizeMode == s.Key ? "active" : "")"
                        @onclick="() => SetSize(s.Key)">
                    @s.Label
                </button>
            </li>
        }
    </ul>
</div>

<!-- Bildirim -->
<button class="btn-ghost btn-icon" title="Bildirimler">
    <SvgIcon Name="icon-bell" Size="15" />
</button>

<!-- Tema toggle -->
<ThemeToggle />

<!-- Avatar menü -->
<div class="dropdown">
    <button class="btn-ghost topbar-avatar-btn" type="button" data-bs-toggle="dropdown">
        <div class="topbar-avatar" style="background:@AvatarColor">
            @Initial
        </div>
    </button>
    <ul class="dropdown-menu dropdown-menu-end" style="min-width:160px;font-size:13px">
        <li class="px-3 py-2" style="border-bottom:1px solid var(--border)">
            <div style="font-weight:600;font-size:13px;color:var(--text-1)">
                @AppState.Session.Email
            </div>
            <div style="font-size:11px;color:var(--text-3)">
                @AppState.Session.CurrentTenantName
            </div>
        </li>
        <li>
            <a class="dropdown-item d-flex align-items-center gap-2 mt-1" href="/profile">
                <SvgIcon Name="icon-person" Size="13" /> Profil
            </a>
        </li>
        <li><hr class="dropdown-divider"></li>
        <li>
            <button class="dropdown-item d-flex align-items-center gap-2 text-danger"
                    @onclick="Logout">
                <SvgIcon Name="icon-logout" Size="13" /> Çıkış
            </button>
        </li>
    </ul>
</div>

@code {
    record SizeOpt(string Key, string Label);
    static readonly SizeOpt[] Sizes =
    [
        new("compact",     "Küçük görünüm"),
        new("default",     "Normal görünüm"),
        new("comfortable", "Geniş görünüm"),
    ];

    string SizeName => AppState.Preferences.SizeMode switch
    {
        "compact" => "Küçük",
        "comfortable" => "Geniş",
        _ => "Normal",
    };

    string Initial => AppState.Session.Email.Length > 0
        ? char.ToUpper(AppState.Session.Email[0]).ToString() : "?";

    string AvatarColor
    {
        get
        {
            string[] p = ["#6366f1", "#8b5cf6", "#ec4899", "#f59e0b", "#10b981", "#0ea5e9"];
            return p[Math.Abs(AppState.Session.Email.GetHashCode()) % p.Length];
        }
    }

    async Task SetSize(string v) => await AppState.SetSizeModeAsync(v);

    async Task Logout()
    {
        await AppState.LogoutAsync();
        Nav.NavigateTo("/login", forceLoad: false);
    }
}