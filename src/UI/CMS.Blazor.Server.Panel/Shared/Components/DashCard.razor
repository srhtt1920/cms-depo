<div class="col-12 col-sm-6 col-xl-3">
    <a href="@Href" class="text-decoration-none">
        <div class="card border-0 shadow-sm h-100 rounded-3">
            <div class="card-body d-flex align-items-center gap-3 p-4">
                <div class="rounded-3 p-3 bg-@Color bg-opacity-10 flex-shrink-0">
                    <NavIcon Name="@Icon" />
                </div>
                <div>
                    <div class="text-muted small mb-1">@Label</div>
                    <div class="h4 fw-bold mb-0">@Value</div>  <!-- ?? Value burada gösteriliyor -->
                </div>
            </div>
        </div>
    </a>
</div>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "/";
    [Parameter, EditorRequired] public string Color { get; set; } = "primary";
    [Parameter, EditorRequired] public string Icon { get; set; } = "home";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public object? Value { get; set; }  // ?? Bu parametre EKLENDÝ
}