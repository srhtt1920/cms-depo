<div class="border rounded-2 mb-2 p-3">
    <div class="d-flex align-items-center gap-2 mb-2">
        <span class="badge bg-secondary" style="font-size:10px">@Block.BlockType</span>
        <span style="font-size:12px;font-weight:500">@SectionName — Block @Block.Order</span>
        @if (Translation is null)
        {
            <span class="badge bg-warning text-dark ms-auto" style="font-size:10px">@Lang.ToUpper() çevirisi eksik</span>
        }
    </div>

    @if (_editing)
    {
        @if (NeedsField("Title"))
        {
            <div class="mb-2">
                <label class="form-label small fw-medium">Başlık</label>
                <input type="text" class="form-control form-control-sm" @bind="_title" />
            </div>
        }
        @if (NeedsField("Body"))
        {
            <div class="mb-2">
                <label class="form-label small fw-medium">İçerik</label>
                <textarea class="form-control form-control-sm" rows="4" @bind="_body"></textarea>
            </div>
        }
        @if (NeedsField("AltText"))
        {
            <div class="mb-2">
                <label class="form-label small fw-medium">Alt Metin</label>
                <input type="text" class="form-control form-control-sm" @bind="_altText" />
            </div>
        }
        @if (NeedsField("LinkText"))
        {
            <div class="mb-2">
                <label class="form-label small fw-medium">Link Metni</label>
                <input type="text" class="form-control form-control-sm" @bind="_linkText" />
            </div>
        }
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary" @onclick="Save" disabled="@_saving">
                @if (_saving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                Kaydet
            </button>
            <button class="btn btn-sm btn-link" @onclick="() => _editing = false">İptal</button>
        </div>
    }
    else
    {
        @if (Translation is not null)
        {
            <div class="text-muted small">@(Translation.Title ?? Translation.LinkText ?? Translation.AltText ?? "(içerik var)")</div>
        }
        <button class="btn btn-sm btn-outline-secondary mt-1" style="font-size:11px"
                @onclick="StartEdit">
            @(Translation is null ? "Çeviri Ekle" : "Düzenle")
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public BlockDto Block { get; set; } = default!;
    [Parameter, EditorRequired] public string SectionName { get; set; } = "";
    [Parameter, EditorRequired] public BlockTranslationDto? Translation { get; set; }
    [Parameter, EditorRequired] public string Lang { get; set; } = "";
    [Parameter, EditorRequired] public Guid ContentId { get; set; }
    [Parameter, EditorRequired] public Guid SectionId { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    bool _editing, _saving;
    string? _title, _body, _altText, _linkText;

    void StartEdit()
    {
        _title = Translation?.Title;
        _body = Translation?.Body;
        _altText = Translation?.AltText;
        _linkText = Translation?.LinkText;
        _editing = true;
    }

    async Task Save()
    {
        _saving = true;
        var r = await ContentApiClient.UpsertBlockTranslationAsync(ContentId, SectionId, Block.Id,
            new UpsertBlockTranslationRequest(Lang, _title, _body, _altText, _linkText));
        _saving = false;
        _editing = false;
        if (r.IsSuccess) await OnSaved.InvokeAsync();
    }

    bool NeedsField(string f) => Block.BlockType switch
    {
        "Text" => f is "Title" or "Body",
        "Image" => f is "AltText",
        "Slider" => f is "Title",
        "Card" => f is "Title" or "Body",
        "Link" => f is "LinkText",
        "Action" => f is "LinkText",
        _ => false,
    };
}