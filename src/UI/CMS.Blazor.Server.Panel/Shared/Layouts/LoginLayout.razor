@inherits LayoutComponentBase
<div data-bs-theme="@AppState.Preferences.Theme"
     style="min-height:100vh;background:var(--bg);display:flex;align-items:center;
            justify-content:center;padding:1.5rem">
    <div style="width:100%;max-width:400px">
        <div style="text-align:center;margin-bottom:28px">
            <div style="display:inline-flex;align-items:center;gap:10px">
                <div style="width:36px;height:36px;background:var(--accent);border-radius:8px;
                            display:flex;align-items:center;justify-content:center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                        <path d="M4 12h16M12 4v16" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
                    </svg>
                </div>
                <span style="font-size:15px;font-weight:700;color:var(--text-1)">CMS Management</span>
            </div>
        </div>
        <div class="card" style="border-radius:10px">
            <div class="card-body" style="padding:28px">
                @Body
            </div>
        </div>
    </div>
</div>
